
process MultipleIncarnation {

  event start Start;
  event end Done;

   task  Introduction;
   task  Conclusion;

  <<ref="Main">>  task  SummarizingNewFeatures;
   <<ref="Main">>  task  AddNewSections;

   task Draft;
   task Implementation;
   task Research;

   merge xor StartIteration;
   split xor EndIteration;
   split and SplitWork;
   merge and MergeWork;


  Start ->
  Research ->
  Draft ->
  StartIteration ->
  Implementation -> SplitWork -> Introduction -> MergeWork;
                    SplitWork -> Implementation -> MergeWork;
                    SplitWork -> AddNewSections -> MergeWork;
                    SplitWork -> Conclusion -> MergeWork -> MergeWork-> SummarizingNewFeatures -> EndIteration -> Done;
                                                                                                   EndIteration -> StartIteration;





}
