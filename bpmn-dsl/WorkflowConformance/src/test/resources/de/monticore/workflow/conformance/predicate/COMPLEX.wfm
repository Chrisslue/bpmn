
process COMPLEX {

  event start Start;
  task Task1;
  task Task2;
  task Task3 ;
  task Task4;
  task Task5;
  task Task6;
  event end End;

  split xor XorSplit ;
  merge xor XorMerge ;
  split and AndSplit;
  merge and AndMerge;

  Start -> XorSplit ;

  XorSplit -> [false] Task1 ;
  XorSplit -> [false] Task2 ;

  Task1 -> XorMerge ;
  Task2 -> XorMerge ;

  XorMerge -> Task3 ;

  Task3 -> AndSplit ;
  AndSplit -> Task4 -> Task6 ;
  AndSplit -> Task5;

  Task6 -> AndMerge;
  Task5 -> AndMerge;

  AndMerge -> End;
}
