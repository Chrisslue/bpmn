
process SequentialWithLoop {

  event start Start;
  event end Done;

  task  Introduction;
  task  Main;
  task Conclusion;
  task Draft;
  task Research;
  task Review;

  merge xor StartIteration;
  split xor EndIteration;


  Start -> Research  -> Draft  -> StartIteration -> Introduction -> Main -> Conclusion  -> Review -> EndIteration
                                                                                                       -> Done;
                  EndIteration -> StartIteration;


}
