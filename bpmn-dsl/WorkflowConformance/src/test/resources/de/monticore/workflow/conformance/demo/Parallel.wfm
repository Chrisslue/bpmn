
process Parallel {

  event start S;
  task T1;
  task T2;
  task T3 ;
  task T4;
  task T5;
  task Task6;
  event end End;

  split xor XorSplit ;
  merge xor XorMerge ;
  split and AndSplit;
  merge and AndMerge;

  S ->  AndSplit  ->  T1 -> T3 -> T5 -> AndMerge;
        AndSplit  ->  T2 -> T4 -> AndMerge ;







 // XorSplit ->  [false] Task1 ;
 // XorSplit ->  [false] Task2 ;

