
process Workflow {

  event start Start;

  Start -> Task1 -> XorSplit;

  split xor XorSplit;
  XorSplit -> [false] Part1;
  XorSplit -> [true] Part2;

  task Part1;
  task Part2;
  task Task1;

  merge xor XorMerge ;

  Part1 -> XorMerge;
  Part2 -> XorMerge;

  XorMerge -> End;

  event end End;

}
