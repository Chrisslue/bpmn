

import de.monticore.bpmn.cds.Domain.*;


process RequestHoliday {

  lane Requester {
    CoordinateInternally;
    FillHolidayCardEntry;
    SubmitHolidayRequest;
    ChooseToComplain;
    ChooseToRetry;
  }

 /* lane Superior {
    CheckHolidayRequest;
    AcknowledgeHolidayRequest;
  }*/

  data holidayCard:HolidayCard;

  event start Start;

  Start -> CoordinateInternally;

  subprocess CoordinateInternally {
    task manual CoordinateWithColleagues;
    task FindSubstitute;
  }

  CoordinateInternally -> FillHolidayCardEntry;

  task user FillHolidayCardEntry {
    io: {} -> { holidayCard };
  }

  FillHolidayCardEntry -> SubmitHolidayRequest;

  task SubmitHolidayRequest;

 /* subprocess CheckHolidayRequest {
    data contract:Contract;

    event start Start;

    Start -> ValidateLeaveDaysAndCheckWaitingPeriod;

    split and ValidateLeaveDaysAndCheckWaitingPeriod; // naming parallel gateways is awkward

    ValidateLeaveDaysAndCheckWaitingPeriod -> ValidateLeaveDays;
    ValidateLeaveDaysAndCheckWaitingPeriod -> CheckWaitingPeriod;

    task ValidateLeaveDays {
      io: {holidayCard} -> {};
    }

    ValidateLeaveDays -> IsRequestValid;

    split xor IsRequestValid;

    IsRequestValid -> [true] ValidateLeaveDaysAndCheckWaitingPeriodJoin ;
    IsRequestValid -> [false] Terminate1 ;

    event Terminate1 send terminate;

    task CheckWaitingPeriod {
      io: {contract} -> {};
    }

    CheckWaitingPeriod -> IsRequesterEligibleForHoliday;

    split xor IsRequesterEligibleForHoliday;

    IsRequesterEligibleForHoliday -> [true] ValidateLeaveDaysAndCheckWaitingPeriodJoin;
    IsRequesterEligibleForHoliday -> [false] Terminate2;

    event Terminate2 send terminate;

    merge and ValidateLeaveDaysAndCheckWaitingPeriodJoin;

    ValidateLeaveDaysAndCheckWaitingPeriodJoin -> End;

    event end End;
  }*/

  //CheckHolidayRequest -> IsHolidayRequestAccepted;

 // split xor IsHolidayRequestAccepted;

 // IsHolidayRequestAccepted -> [true] AcknowledgeHolidayRequest;
 // IsHolidayRequestAccepted -> [false] ChooseToRetry;

 /* task AcknowledgeHolidayRequest {
    io: {holidayCard} -> {holidayCard};
  }

  AcknowledgeHolidayRequest -> End1;*/

  //event end End1;

  task ChooseToRetry;

  ChooseToRetry -> Retry;

  split xor Retry;

  Retry -> [false] End2;
  Retry -> [true] IsEscalationPossible;

  event end End2;

  split xor IsEscalationPossible;

  IsEscalationPossible -> CoordinateInternally;
  IsEscalationPossible -> [3 > 3] ChooseToComplain;

  task ChooseToComplain;

  ChooseToComplain -> Complain;

  split xor Complain;

  Complain -> [false] CoordinateInternally;
  Complain -> [true] SendComplaint;

  task send SendComplaint compensate:complaint;

  message complaint:Complaint;

  SendComplaint -> ReceiveAnswer;

  task receive ReceiveAnswer compensate:answerToComplaint;

  message answerToComplaint:ComplaintResponse;

  ReceiveAnswer -> End3;

  event end End3;
}
