
process CTL {

  event start S;
  task T1;
  task T2;
  task T3 ;
  task T4;
  task T5;
  task Task6;
  event end End;

  split xor XorSplit ;
  merge xor XorMerge ;
  split and AndSplit;
  merge and AndMerge;

  S ->  T1  ->  T2 ->  XorSplit -> T3 ;
                       XorSplit -> T4 ;

  T3-> XorMerge ;
  T4 -> XorMerge;

  XorMerge -> T5;





