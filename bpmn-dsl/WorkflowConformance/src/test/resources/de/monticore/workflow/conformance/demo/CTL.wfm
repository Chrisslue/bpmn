
process CTL {

  event start S;
  task T1;
  task T2;
  task T3 ;
  task T4;
  task T5;
  task T6;
  task T7;
  task T8;
  event end End;

  split xor XorSplit ;
  merge xor XorMerge ;
  split and AndSplit;
  merge and AndMerge;

  split xor XorSplit2;

  S ->   XorSplit -> T1 ;
         XorSplit -> T2 ;

  T1-> XorMerge ;
  T2 -> XorMerge;

  XorMerge -> T3;

  T3 -> AndSplit -> T4 -> T6;
        AndSplit -> T5;

  T6 -> AndMerge   ;
  T5 -> XorSplit2 -> T7 ->End ;
        XorSplit2 -> T8 ->End ;

  T6 -> AndMerge -> End;





 // XorSplit ->  [false] Task1 ;
 // XorSplit ->  [false] Task2 ;

 /* Task1 ->  XorMerge ;
  Task2 ->  XorMerge ;

  XorMerge -> Task3 ;

  Task3 -> End ;
 /* AndSplit -> Task4 -> Task6 ;
  AndSplit -> Task5;

  Task6 -> AndMerge;
  Task5 -> AndMerge;

  AndMerge -> End;*/
}
