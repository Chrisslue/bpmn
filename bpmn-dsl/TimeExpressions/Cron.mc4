package de.monticore.expressions;

component grammar CronExpressions
        extends de.monticore.ExpressionsBasis,
                de.monticore.literals.Literals {

  // https://docs.camunda.org/javadoc/camunda-bpm-platform/7.3/org/camunda/bpm/engine/impl/calendar/CronExpression.html
  // https://github.com/schyntax/schyntax

  CronExpression =
      second:CronSeconds
      minute:CronMinutes
      hour:CronHours
      dayOfMonth:CronDayOfMonth
      month:CronMonth
      dayOfWeek:CronDayOfWeek
      year:CronYears?;

/* Maybe use this general defintion and write CoCos
  CronField =
      (value:IntLiteral | [asterisk:"*"]) ("/" increment:IntLiteral)?
    | value:IntLiteral ("#" nth:ONE_TO_FIVE)?
    | [wildcard:"?"]
    | from:IntLiteral "-" to:IntLiteral
    | values:(IntLiteral || ",")+
    | [last:"L"] ([weekday:"W"] | ("-" offset:IntLiteral))?
*/

  CronSeconds = SECOND;

  /*
      (value:SECOND | [asterisk:"*"]) ("/" increment:IntLiteral)?
    | from:SECOND "-" to:SECOND
    | values:(SECOND || ",")+
    ;
  */
  CronMinutes =
      (value:MINUTE | [asterisk:"*"]) ("/" increment:IntLiteral)?
    | from:MINUTE "-" to:MINUTE
    | values:(MINUTE || ",")+
    ;
  CronHours =
      (value:HOUR | [asterisk:"*"]) ("/" increment:IntLiteral)?
    | (from:HOUR "-" to:HOUR)
    | values:(HOUR || ",")+
    ;
  CronDayOfMonth  =
      (value:DAY_OF_MONTH | [asterisk:"*"]) ("/" increment:IntLiteral)?
    | value:DAY_OF_MONTH ([weekday:"W"])?
    | [wildcard:"?"]
    | from:DAY_OF_MONTH "-" to:DAY_OF_MONTH
    | values:(DAY_OF_MONTH || ",")+
    | [last:"L"] ([weekday:"W"] | ("-" offset:IntLiteral))?
    ;
  CronMonth =
      (value:MONTH | [asterisk:"*"]) ("/" increment:IntLiteral)?
    | from:DAY_OF_MONTH "-" to:DAY_OF_MONTH
    | values:(MONTH || ",")+
    ;
  CronDayOfWeek =
      (value:DAY_OF_WEEK | [asterisk:"*"]) ("/" increment:IntLiteral)?
    | value:DAY_OF_WEEK ("#" nth:ONE_TO_FIVE)? // if '#' is not present, first alternative should have already matched
    | [wildcard:"?"]
    | from:DAY_OF_WEEK "-" to:DAY_OF_WEEK
    | values:(DAY_OF_WEEK || ",")+
    | [last:"L"] ("-"offset:IntLiteral)?
    ;
  CronYears =
      (value:YEAR | [asterisk:"*"]) ("/" increment:IntLiteral)?
    | (from:YEAR "-" to:YEAR)
    | values:(YEAR || ",")+
    ;


  token SECOND = '0' : int;
      //DIGIT | (('1'..'5') DIGIT)
    //: int // we must stay with strings, since if we use 'int', Optional<String> is replaced by int and we no longer know if the value is not set or zero
    //;
  token MINUTE = SECOND;
  token HOUR =
      DIGIT | '1' DIGIT | '2' ('0'..'3')
    ;
  token DAY_OF_MONTH =
      DIGIT | ('1'..'2') DIGIT | '3' ('0'..'1')
    ;
  token MONTH =
      ('1'..'9') | '1'('0'..'2')
    | "JAN" | "FEB" | "MAR" | "APR" | "MAI" | "JUN" | "JUL" | "AUG" | "SEP" | "OCT" | "NOV" | "DEC"
    ;
  token DAY_OF_WEEK =
      ('1'..'6')
    | "MON" | "TUE" | "WED" | "THU" | "FRI" | "SAT" | "SUN"
    ;
  token YEAR = // 1970-2099
      ('1' '9' ('7'..'9') DIGIT)
    | ('2' '0' DIGIT DIGIT)
    ;

  fragment token DIGIT = ('0'..'9');

  token ONE_TO_FIVE = ('1'..'5');

}