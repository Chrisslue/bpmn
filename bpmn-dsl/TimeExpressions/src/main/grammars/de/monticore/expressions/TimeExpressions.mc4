package de.monticore.expressions;

grammar TimeExpressions extends de.monticore.literals.MCCommonLiterals {

  interface TimeExpression;


  TimeExpr implements TimeExpression =
      "at" Time
    ;

  DateExpr implements TimeExpression =
      "on" Date TimeExpr?
    ;

  AfterExpr implements TimeExpression =
      "after" period:Period
    ;

  EveryExpr implements TimeExpression =
      ("start" start:DateExpr ",")? (times:NatLiteral "times")? "every" period:Period
    ;

  CronExpr implements TimeExpression =
      "cron" value:String
    ;

  Time =
      hours:NatLiteral ":" {noSpace()}? minutes:NatLiteral {noSpace()}? (":" {noSpace()}? seconds:NatLiteral {noSpace()}?)?
    ;

  Date =
      year:NatLiteral "-" {noSpace()}? month:NatLiteral {noSpace()}? "-" {noSpace()}? day:NatLiteral {noSpace()}?
    ;

  Period = value:Name; //PERIOD;

}
