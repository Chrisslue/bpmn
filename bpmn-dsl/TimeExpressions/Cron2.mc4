package de.monticore.expressions;

component grammar Cron extends de.monticore.literals.Literals {

  // based on https://github.com/schyntax/schyntax

  Cron =
      CronField+
    ;

  CronField =
      type:FieldName "(" (CronArgument || ",")+ ")"
    ;

  CronArgument =
      ([negate:"!"])? (value:CronSimpleValue | range:CronRangeValue)
    ;

  CronSimpleValue =
      ([star:"*"] | value:Value)("/" NoWSLast2 interval:Value NoWSLast2)?
    ;

  CronRangeValue =
      Value
      (".." | [exclusive:"..<"])
      NoWSLast2
      Value
      NoWSLast2
    ;


  Value =
      numeric:IntLiteral
    | weekday:WeekDay
    | month:Month
    ;


  enum FieldName =
      SECOND:       "sec"
    | MINUTE:       "min"
    | HOUR:         "hrs"
    | DAY_OF_MONTH: "dayOfMonth"
    | MONTH:        "mos"
    | DAY_OF_WEEK:  "dayOfWeek"
    | DATES:        "dates"
    ;

  enum WeekDay =
      MONDAY:   "mon"
    | TUESDAY:  "tue"
    | WEDNESDAY:"wed"
    | THURSDAY: "thu"
    | FRIDAY:   "fri"
    | SATURDAY: "sat"
    | SUNDAY:   "sun"
    ;

  enum Month =
      JANUARY:  "jan"
    | FEBRUARY: "feb"
    | MARCH:    "mar"
    | APRIL:    "apr"
    | MAI:      "mai"
    | JUNE:     "jun"
    | JULI:     "jul"
    | AUGUST:   "aug"
    | SEPTEMBER:"sep"
    | OCTOBER:  "oct"
    | NOVEMBER: "nov"
    | DECEMBER: "dec"
    ;


  // See MontiCore Reference Manual, section 18.4.3 - Preventing Whitespaces between Tokens
  NoWSLast2 = {noSpace()}? ;

}