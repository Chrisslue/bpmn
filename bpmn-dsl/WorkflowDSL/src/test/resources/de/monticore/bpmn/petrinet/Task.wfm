package de.monticore.bpmn.petrinet;

import de.monticore.bpmn.cds.Domain.*;

process Task {
  
  task T1;
  
  
  task T2 {
    boundary event E1 timer [after P12D];
  }
  
  
  task T3;

  
  T1 -> split xor -> {
    T2;
    T3;
  };
  
  T2.E1 -> T3;
  
  subprocess S1 {

    task T4;

    start event E2;
    end event E3;

    E2 -> T4 -> E3;
    
  }
  
  
}
