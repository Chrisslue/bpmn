package de.monticore.bpmn.cocos.flows.valid;

import de.monticore.bpmn.cds.Domain.*;

process BoundaryEventHasNoIncomingFlow {

  message msg:LeaveCard;

  task T1 {
    boundary event E1 message msg;
  }

  subprocess S1 {
    task T2{
      boundary event E2 message msg;
    }

  }

  task T2;

}