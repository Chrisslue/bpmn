package de.monticore.bpmn.cocos.gateways.invalid;

import de.monticore.bpmn.cds.Domain.*;

process EventGatewayTargetReceiveTaskHasNoBoundaryEvents {

  message msg:Contract;

  task T1;

  receive task T2 {
    webservice = ##unspecified;
    message = msg;
  }
  receive task T3 {
    webservice = ##unspecified;
    message = msg;
    boundary event E1 cancel;
  }

  split receive first G1;

  T1 -> G1 -> {T2; T3;};

}