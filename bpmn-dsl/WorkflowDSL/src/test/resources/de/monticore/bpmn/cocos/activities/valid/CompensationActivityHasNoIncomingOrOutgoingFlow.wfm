package de.monticore.bpmn.cocos.activities.valid;

import de.monticore.bpmn.cds.Domain.*;

process CompensationActivityHasNoIncomingOrOutgoingFlow {

  task T1;

  call-activity T3 calls TaskContainsOnlyBoundaryEvents{
    boundary event E2 with T1;
    }

}