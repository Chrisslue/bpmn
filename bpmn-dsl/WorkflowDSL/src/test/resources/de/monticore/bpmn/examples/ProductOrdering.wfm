package de.monticore.bpmn.examples;

process ProductOrdering {

    start event BeginOrderProcessing;
    
    lane Sales{
        task ReceiveOrder;
        task CheckOrderDetails;
        split xor IsProductAvailable;
        end event OrderCancelled;

        StartOrder -> ReceiveOrder -> CheckOrderDetails -> IsProductAvailable;
        IsProductAvailable -> PrepareProduct;
    };

    
    lane Warehouse{
        task PrepareProduct;
        task ShipOrder;

        PrepareProduct -> ShipOrder -> OrderProcessingCompleted;
    };

    end event OrderProcessingCompleted;

    
    
}