package de.monticore.bpmn.cocos.gateways.valid;

import de.monticore.bpmn.cds.Domain.*;

process EventGatewayDoesNotMixMessageEventsAndReceiveTasks {

  message msg:Contract;
  message sig:Report;


  task T1;

  event E1 receive message:msg;
  event E2 receive message:msg;

  split receive:first G1;

  T1 -> G1 -> {E1, E2};


  task T2;

  task receive T3 message:msg;
  task receive T4 message:msg;

  split receive:first G2;

  T2 -> G2 -> {T3, T4};


  task T5;

  task receive T6 message:msg;
  event E3 receive signal:sig;

  split receive:first G3;

  T5 -> G3 -> {T6, E3};

}