package de.monticore.bpmn.cocos.events.triggers.invalid;

import de.monticore.bpmn.cds.Domain.*;

process EndEventHasValidTrigger {

  message msg:Contract;
  signal sig:Contract;

  event end E1 timer:[on 19-11-2018 at 23:55];
  event end E2 when:[true];
  event end E3 one { message:msg, signal:sig };

}