package de.monticore.bpmn.cocos.events.triggers.invalid;

import de.monticore.bpmn.cds.Domain.*;

process NonInterruptingEventHasValidTrigger {

  error err:LeaveCard;

  subprocess S1 {
    start event E01 catch noninterrupt error err;
    end event E03;

    E01 -> E03;

  }

  subprocess S2 {
    start event E02 catch noninterrupt compensate;
    end event E04;

    E02 -> E04;
  }


  task T1 {
    boundary event E11 catch noninterrupt error err;
  }

  task T2 {
    boundary event E12 catch noninterrupt cancel;
  }

  task T3 {
    boundary event E13 catch noninterrupt compensate;
  }

}
