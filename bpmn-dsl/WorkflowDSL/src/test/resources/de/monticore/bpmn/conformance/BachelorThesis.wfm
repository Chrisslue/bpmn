process BachelorThesis{
    start event StartThesis;
    end event EndThesis;

    task LiteratureResearch;
    task Development;
    task Evaluation;
    task ThesisDraft;
    task Introduction;
    task Main;
    task Conclusion;
    
    split and SplitAnd;
    merge and MergeAnd;
    split xor SplitXor;
    merge xor MergeXor;

    StartThesis -> LiteratureResearch -> Development -> Evaluation -> MergeXor -> ThesisDraft -> SplitAnd ->
        {
            Introduction;
            Main;
        }
    -> MergeAnd -> SplitXor;
    SplitXor -> EndThesis;
    SplitXor -> MergeXor;

}