package de.monticore.bpmn.cocos.events.triggers.invalid;

import de.monticore.bpmn.cds.Domain.*;

process IntermediateCatchEventHasValidTrigger {

  escalation esc:Contract;
  error err:Contract;

  event E1 receive;
  event E2 receive escalate:esc;
  event E3 receive error:err;
  event E4 receive cancel;
  event E5 receive compensate;
  event E6 receive terminate;

}