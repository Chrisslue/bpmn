package de.monticore.bpmn.cocos.events.triggers.invalid;

import de.monticore.bpmn.cds.Domain.*;

process IntermediateCatchEventHasValidTrigger {

  escalation esc:Contract;
  error err:Contract;

  event E1 catch;
  event E2 catch escalation esc;
  event E3 catch error err;
  event E4 catch cancel;
  event E5 catch compensate;
  event E6 catch terminate;

}
