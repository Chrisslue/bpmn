package de.monticore.bpmn.cocos.activities.invalid;

import de.monticore.bpmn.cds.Domain.*;

process AdHocSubProcessHasNoStartAndEndEvent {

  adhoc S1 {
    start event E1;
    task T1;
  }

  adhoc S2 {
    end event E2;
    task T2;
  }

  adhoc S3 {
    start event E3;
    end event E4;
    task T3;
  }

}