package de.monticore.bpmn.cocos.gateways.valid;

import de.monticore.bpmn.cds.Domain.*;


process EventGatewayOutgoingFlowsHaveNoCondition {

  message msg:Contract;

  receive task T1{
    webservice = ##unspecified;
    message = msg;
  }

  receive task T2{
    webservice = ##unspecified;
    message = msg;
  }

  split receive first G1;

  G1 -> {T1; T2;};

}