package de.monticore.bpmn.cocos.events.triggers.invalid;

import de.monticore.bpmn.cds.Domain.*;

process IntermediateThrowEventHasValidTrigger {

  error err:Contract;
  message msg:Contract;
  signal sig:Contract;

  event E1 send timer [on 19-11-2018 at 23:55];
  event E2 send when [true];
  //event E3 send error:err;
  event E4 send cancel;
  //event E5 send one { message:msg, signal:sig };
  event E6 send terminate;

}