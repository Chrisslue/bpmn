package de.monticore.bpmn.cocos.events.triggers.invalid;

import de.monticore.bpmn.cds.Domain.*;

process IntermediateThrowEventHasValidTrigger {

  error err:Contract;
  message msg:Contract;
  signal sig:Contract;

  event E1 throw timer [on 19-11-2018 at 23:55];
  event E2 throw when [true];
  event E3 throw error err;
  event E4 throw cancel;
  event E5 throw one { message msg, signal sig };
  event E6 throw terminate;

}