package de.monticore.bpmn.cocos.events.triggers.invalid;

import de.monticore.bpmn.cds.Domain.*;

process StartEventTopLevelProcessHasValidTrigger {

  escalation esc:Contract;
  error err:Contract;

  start event E1 escalation esc;
  start event E2 error err;
  start event E3 cancel;
  start event E4 compensate;
  start event E5 terminate;

}