process ReferenceModel{

    start event BeginWork;
    end event EndWork;

    task Draft;
    task Introduction;
    task MainPart;
    task Conclusion;

    split and SplitAnd;
    merge and MergeAnd;
    split xor SplitXor;
    merge xor MergeXor;

    BeginWork -> MergeXor -> Draft -> SplitAnd -> 
        {   Introduction,
            MainPart,
            Conclusion
        } 
    -> MergeAnd -> SplitXor;
    SplitXor -> MergeXor;
    SplitXor -> EndWork;

}