package de.monticore.bpmn;

grammar Workflow
        extends de.monticore.ocl.OCL,
                de.monticore.expressions.TimeExpressions,
                de.monticore.symbols.OOSymbols {

  start WorkflowCompilationUnit;

  /* Expression Language, e. g. OCL */

  WorkflowCompilationUnit =
      MCPackageDeclaration?
      MCImportStatement*
      Process
    ;
    

  /*========================================================================*/
  /*=============================== PROCESS ================================*/
  /*========================================================================*/

  /* all elements that can appear in a Process flow e.g. Activities, Gateways, Events ... */
  interface FlowElement;

  /* superset of elements contained in BPMNs */
  interface FlowElementContainer = Name FlowElement*;

  /* represents a model element that can be called */
  interface symbol CallableElement =
      Name
      IOSpecification
      // supported Interface?
      // ioBinding?
    ;

  /* Graph of FlowElements */
  symbol scope Process implements CallableElement, FlowElementContainer =
      "process" Name
      // missing many attributes like ProcessType, Properties, Ressources ...
      "{"
        IOSpecification
        (   Lane        // Split Lanes and FlowElements into two separat Productions?
          | FlowElement
        )*
      "}"
    ;

  /* sub-partition within a Process to organize Activities within a Pool */
  symbol Lane =
      "lane" Name
      "{"
        (   childLane:Lane  // Split Lanes and FlowElements into two separat Productions?
          | FlowElement
        )*
      "}"
    ;
  astrule Lane =
      parentLane:String?
    ;


  /*========================================================================*/
  /*============================== ACTIVITIES ==============================*/
  /*========================================================================*/

  interface FlowNode ;

  interface GlobalFlowNode extends FlowNode, FlowElement; // TODO naming? BaseFlowNode, RootFlowNode, TopLevelFlowNode, LocalFlowNode, NamedFlowNode, CommonFlowNode?
  interface InlineFlowNode extends FlowNode ;

  astrule FlowNode astextends ASTFlowElement, IFlowNode = // IFlowNode provides additional default methods for predecessors/successors
      parentRef:String?
      laneRef:String?
      incomings:List<de.monticore.bpmn.workflow._ast.SequenceFlow>
      outgoings:List<de.monticore.bpmn.workflow._ast.SequenceFlow>
    ;

  /* work performed within a Business Process */
  interface Activity extends GlobalFlowNode =
      Name
      CompensationHandler?
      LoopCharacteristics?
    ;

  /* Activity whose internal details are modelled using Activites, Events ... */
  symbol scope SubProcess implements Activity, FlowElementContainer  =
      type:SubProcessType
      Name
      AdHocCharacteristics?
      CompensationHandler?
      LoopCharacteristics?
      "{"
        IOSpecification // IOSpecification is not allowed here by BPMN standard, but we include it here to be able to show a suitable error message
        (   Lane        // Split Lanes and FlowElements into two separat Productions?
          | FlowElement
        )*
      "}"
    ;

  /* possible Types for SubProcesses */
  enum SubProcessType =
      "subprocess"
    | "transaction"
    | "adhoc"
    ;

  /* needed in case it is an Ad-Hoc Sub Process */
  /* set of Activites that do not require any Sequence relationships */
  AdHocCharacteristics =
      ("until" ":" "[" completionCondition:Expression "]")
      (   "parallel" (waitForRemainingInstances:["noninterrupt"])?
        | ["sequential"]
      )?
    ;

  astrule SubProcess =
      triggeredByEvent:boolean
    ;

  /* Non-decomposable Activity */
  interface symbol scope AtomicActivity extends Activity =
      Name
      IOSpecification?
      (boundaryEvent:NamedEvent)*
    ;

  /* can override properties of the element beeing called */
  CallActivity implements AtomicActivity =
      "task"
      Name
      "template" ":" template:Name@CallableElement  // defines the calledElement, unprecise  naming?
      CompensationHandler?
      LoopCharacteristics?
      (   "{"
            IOSpecification         // must match the I/O requirements of the called element
            (boundaryEvent:NamedEvent)*
          "}"
        | ";"
      )
    ;

  /* AtomicActivity that is included within the process */
  Task implements AtomicActivity =
      "task"
      type:TaskType?
      Name
      TaskTypeAttributes?
      CompensationHandler?
      LoopCharacteristics?
      (   "{"
            IOSpecification
            (boundaryEvent:NamedEvent)*
          "}"
        | ";"
      )
    ;

  /* possible Types for Tasks */
  enum TaskType =
      "service"
    | "send"
    | "receive"
    | "user"
    | "manual"
    | "rule" // BusinessRule ?
    | "script"
    ;

  interface TaskTypeAttributes;

  /* Attributes for the other types are missing */
  TaskSendReceiveTypeAttributes implements TaskTypeAttributes =
      "message" ":" message:Name@Notification
    ;

  /* Activites that are not connected to other parts of the BPMN model */
  CompensationHandler =
      "compensate" ":" activity:Name // @Activity
    ;

  interface LoopCharacteristics;

  /* looping behavior based on loopCondition */
  StandardLoop implements LoopCharacteristics =
      (testBefore:["while"] | "until") ":" "[" loopCondition:Expression "]" // use "true" and "false" instead of "while" and "until" ?
      ("max" ":" loopMaximum:NatLiteral)?
    ;

  /* allows a multiple number of Activity instances */
  MILoop implements LoopCharacteristics =
      "count" ":" LoopCardinality
      ("parallel" | "sequential")?
      ("until" ":" "[" completionCondition:Expression "]")?
      ("implicit" ":" implicitBehavior:MIImplicitEventBehavior)?
      ("event" ":"    implicitEventDef:EventTrigger           )?
    ;

  astrule MILoop =
      loopDataInput: Name
      loopDataOutput:Name
    ;

  /* specifies when Events shall be thrown */
  MIImplicitEventBehavior =
      ["none"]
    | ["first"]
    | ["every"]
    | "[" complexCondition:Expression "]"
    ;

  /* controls the number of Activites created by a MILoop */ 
  LoopCardinality =
      count:NatLiteral
    | ("[" expression:Expression "]")
    | collection:Name // what is meant by collection? do we use this option?
    ;


  /*========================================================================*/
  /*=============================== GATEWAYS ===============================*/
  /*========================================================================*/

  // cannot be an abstract class, due to a bug in MC v5.0.2 (attributes from interface NT FlowNode are not inherited)
  interface Gateway extends FlowNode =
      direction:GatewayDirection 
      type:GatewayType
    ;

  /* named Gateway at Process-Level */
  symbol NamedGateway implements Gateway, GlobalFlowNode =
      direction:GatewayDirection
      type:GatewayType
      Name
      ("[" activationCondition:Expression "]")?  // complex gateway
      ";"
    ;

  /* Gateway inlined in the SequenceFlow */
  InlineGateway implements Gateway, InlineFlowNode =
      direction:GatewayDirection
      type:GatewayType
      ("[" activationCondition:Expression "]")?  // complex gateway
    ;

  /* specifies how the Gateway may be used */
  /* different naming: Unspecified, Converging, Diverging and Mixed */
  enum GatewayDirection =
      "split"
    | "merge"
    ;
    
  /* possible Types of Gateways */
  GatewayType =
      [exclusive:"xor"]
    | [inclusive:"ior"]
    | [parallel: "and"]
    | ("receive" ":" [exclusiveEventBased:"first"])
    | ("receive" ":" [ parallelEventBased:  "all"])
    | ["complex"]
    ;


  /*========================================================================*/
  /*================================ EVENTS ================================*/
  /*========================================================================*/

  /* happens during a Process */
  interface Event extends FlowNode =
      type:EventType? 
      behavior:EventBehavior? 
      trigger:EventTrigger?
    ;

  /* named Event at Process-Level */
  symbol NamedEvent implements Event, GlobalFlowNode =
      (boundary:["<<boundary>>"])?
      "event" type:EventType?
      Name
      behavior:EventBehavior? 
      trigger:EventTrigger?
      (   "{"
            (input:IRequirement | output:ORequirement)
          "}"
        | ";"
      )
    ;

  /* Event inlined in the SequenceFlow */
  InlineEvent implements Event, InlineFlowNode =
      "event" type:EventType?
      behavior:EventBehavior? 
      trigger:EventTrigger?
    ;

  /* possible Types of Events */
  enum EventType =
      "start"
    | "end"   // "intermediate" missing?
    ;

  /* Events are either catching or throwing */
  EventBehavior =
        throw:["send"]
      | catch:["receive"] (nonInterrupt:["noninterrupt"])? // TODO move noninterrupt behind the trigger?
    ;

  interface EventTrigger;

  /* all BPMN triggers except the link trigger */
  EventTriggerCancel       implements EventTrigger = "cancel";
  EventTriggerCompensate   implements EventTrigger = "compensate" (":" activity:Name)? ["async"]?;
  EventTriggerConditional  implements EventTrigger = "when"        ":" "[" Expression "]";
  EventTriggerError        implements EventTrigger = "error"       ":" error:Name@Notification;
  EventTriggerEscalate     implements EventTrigger = "escalate"    ":" escalate:Name@Notification;
  EventTriggerMessage      implements EventTrigger = "message"     ":" message:Name@Notification;
  EventTriggerSignal       implements EventTrigger = "signal"      ":" signal:Name@Notification;
  EventTriggerTerminate    implements EventTrigger = "terminate";
  EventTriggerTimer        implements EventTrigger = "timer"       ":" "[" expression:TimeExpression "]";
  EventTriggerMultiple     implements EventTrigger = ("one" | parallelMultiple:["all"]) "{" trigger:(EventTrigger || ",")+ "}";


  /*========================================================================*/
  /*============================= CONTROL FLOW =============================*/
  /*========================================================================*/

  /* models the SequenceFlow by chaining FlowTargets */
  SequenceFlow implements FlowElement =
      path:(FlowTarget || "->")+
      ";"
    ;

  /* specifies a set of parallel branches */
  FlowBlock =
      "{" branch:(FlowBranch || ",")+ "}"
    ;

  FlowBranch =
      path:(FlowTarget || "->")+
    ;

  /* reference a FlowNode using its name, define a FlowNode inside or create a block structure */
  FlowTarget =
      condition:FlowCondition?
      (   nodeRef:MCQualifiedName
        | node:InlineFlowNode
        | block:FlowBlock
      )
    ;

  /* Type of SequenceFlow */
  FlowCondition =
      "[" Expression "]"
    | default:["<<default>>"]
    ;

  /*========================================================================*/
  /*================================ DATA ==================================*/
  /*========================================================================*/

  /* represents a data object or data store */
  symbol DataObject implements FlowElement, Variable =
      ("data" | ["store"]) Name ":" MCType ";"
    ;


  /*========================================================================*/
  /*========================== I/O REQUIREMENTS ============================*/
  /*========================================================================*/

  IOSpecification = IORequirement* ;

  /* input requirement, ouput requirement or input-output rule */
  interface IORequirement;

  /* specifies data input or data output */
  DataIO =
      MCQualifiedName
      (loop:["[i]"] {noSpace()}?)?
      (":" MCType)?
      (
        (   optional:["?"]
          | whileExecuting:["!"]
        )
        {noSpace()}?
      )?
      ("as" alias:Name)?
    ;

  /* Set of input and output data */
  DataSet  =  DataIO | "{" (DataIO || ",")* "}" ;

  IRequirement implements IORequirement = "in"  ":" inputSet :DataSet  ";" ;
  ORequirement implements IORequirement = "out" ":" outputSet:DataSet ";" ;

  IORule implements IORequirement =
      "io" (operationName:Name)? ":" inputSet:DataSet "->" outputSet:DataSet ";"
    ;


  /*========================================================================*/
  /*================================ MISC ==================================*/
  /*========================================================================*/

  symbol Notification implements FlowElement, Variable =
    kind:["error"|"escalation"|"message"|"signal"] Name ":" MCType ";" ;

  symbolrule Notification =
    isError: boolean
    isEscalation: boolean
    isMessage: boolean
    isSignal: boolean;

  nokeyword "timer";

}
