package de.monticore.bpmn;

grammar Workflow extends de.monticore.expressions.LambdaExpressions,
                         de.monticore.expressions.AssignmentExpressions,
                         de.monticore.expressions.CommonExpressions, 
                         de.monticore.timer.TimerConditions,
                         de.monticore.symbols.OOSymbols,
                         de.monticore.UMLModifier{

  /* Expression Language, e. g. OCL */

  WorkflowCompilationUnit =
      MCPackageDeclaration?
      MCImportStatement*
      WFProcess
    ;

  /**
    Workflow describes a textual representation of business process models
    that is based on BPMN 2.0 standard. It focusses on modelling of business 
    processes, with the aim of providing a structured notation for elements 
    in a workflow and their interaction.
    It covers [sub]processes, lanes, events, gateways, various types of 
    activities and more.

    The grammar builds on
    * LambdaExpressions, AssignmentExpressions and CommonExpressions
        to allow for different types of expressions
    * TimerConditions
        for the specification of timing constraints
    * OOSymbols
        to include types, variables and methods
    * UMLModifier
        to stereotype the elements for conformance checking 

   */

  /*========================================================================*/
  /*=============================== PROCESS ================================*/
  /*========================================================================*/

  /**
   * FlowElement describes general elements of a workflow process.
     which includes sequenceflows lanes dataobjects and notifications.
   */ 
  interface FlowElement;

  /**
   * FlowNode extends FlowElement and represents specific nodes that can appear in a
     sequence flow  e.g. subprocess, task, callActivity, gateway, event etc.
   */ 
  interface FlowNode extends FlowElement;

  /** 
   * The astrule will generate attributes and corresponding methods in the AST-classes that 
     implement the interface FlowNode.
   * This avoids additional attributes and methods in the handwritten AST-classes.
   */  
  astrule FlowNode = 
      incomings:List<de.monticore.bpmn.workflow._ast.SequenceFlow>
      outgoings:List<de.monticore.bpmn.workflow._ast.SequenceFlow>
    ;


  /** 
   * WFProcess describes a workflow which contains lanes and flow elements in any order.
   * A process may be designated with a Modifier and can have io-requirements.
   */
  symbol scope WFProcess =
      Modifier "process" Name "{"
        IORequirement*
        ( FlowElement | ";" )*
      "}"
    ;

  /**
   * WFLane represents a sub-partition within a process which contains flow elements and sub-lanes.
   * Every lane has a name and denotes for example a business function or a role.
   */
  WFLane implements FlowElement =
              "lane" Name "{"
                ( FlowElement | ";" )*
              "}"
            ;


  /*========================================================================*/
  /*============================== ACTIVITIES ==============================*/
  /*========================================================================*/

  /** 
   * WFActivity denotes a unit of work performed within a business process.
   * It can be atomic or non-atomic.
   */
  interface symbol WFActivity extends FlowNode =
      Modifier Name LoopCharacteristics?
    ;

  /**
   * This symbolrule describes whether the corresponding activity compensates
     for another activity and, in this case, refers to one. 
   */
  symbolrule WFActivity =
    compensating:boolean
    compensates:WFActivitySymbol
  ;

  /**
   * WFSubprocess represents a sub-workflow that is modelled using tasks, gateways, events etc.  
   * "subprocess":  It describes an embedded subprocess.
   * "transaction": It models complex business scenarios and ensures that all parts are completed
                    successfully or are handled in case of failure. 
   * "adhoc":       It represents a collection of activities with no required sequence 
                    relationships. This means that the subprocess is flexible in its task execution.   
   */
  symbol scope WFSubProcess implements WFActivity =
      Modifier type:["subprocess" | "transaction" | "adhoc" ] Name
      AdHocCharacteristics?
      LoopCharacteristics?
      "{"
        ( FlowElement | ";" )*
      "}"
    ;


  /** 
   * AdHocCharacteristics is required if it is an ad-hoc subprocess.
   * An ad-hoc subprocess does not require any sequence relationships.
   * TODO: Add a coco that checks if this nonterminal is set if it is an ad-hoc subprocess.
   */
  AdHocCharacteristics =
      ("until" ":" "[" completionCondition:Expression "]")
      ( ["parallel"] (waitForRemainingInstances:["noninterrupt"])? | ["sequential"] )?
    ;

  /**
   * CallActivity calls another reusable process or global task. 
   * In this grammar, global tasks are modelled as a processes with only one task.
   * Example: A call activity "ShipOrder" calls a process named "ShippingProcess".
   * TODO: Add a coco that checks if the I/O requirements match with the ones of the called element.
   */
  WFCallActivity implements WFActivity =
      Modifier "call-activity" Name "calls" ":" calledElement:Name@WFProcess
      LoopCharacteristics?
      (   "{"
            IORequirement*        
            ("boundary" boundaryEvent:WFEvent)*
          "}" )?
    ;

  /** 
   * Task represents an atomic activity within a workflow.
   * "service": automated by software and can use external applications
   * "send":    sending message to an external system or participant
   * "receive": waiting for an incoming message from an external system or participant
   * "user":    performed by a person with the support of software
   * "manual":  performed physically without the aid of software
   * "rule":    used to interact with a business rule engine
   * "script":  execution of script directly within the process model
   */
  WFTask implements WFActivity =
      Modifier type:["service"|"send"|"receive"|"user"|"manual"|"rule"|"script"]? "task" Name
      LoopCharacteristics?
      (   "{"
             TaskTypeAttributes?
             IORequirement*
             ("boundary" boundaryEvent:WFEvent)*
          "}" )?
    ;
  

  /**
   * TaskTypeAttributes describes potential attributes for all types of tasks.
   * service: used webservice and optionally the operation triggered by the task
   * send:    used webservice, message and the operation triggered by the task
   * receive: used webservice, message and the operation triggered by the task
   * user:    used webservice   
   * manual:  needed resources
   * rule:    used webservice
   * script:  used script and the format of the script
   * TODO: Add a coco that checks if the attributes are set for the specific task type.
   */ 
  TaskTypeAttributes =
      (
          // valid Strings are ##unspecified, ##webservice or a URI 
          ("webservice" "=" webservice:String ";")

          // references an operation
          ("operation" ":" operation:Name@Operation ";")?

          // used in send and receive tasks for communication 
          ("message" ":" message:Name@Notification ";")?
        |
          // format of the script and a script that can be run when a task is performed 
          "script" "(" scriptFormat:String ")" "=" "{" script:String "}" ";"
        |
          // human resources or other resources assigned to tasks 
          "resources" ":" resources:(MCQualifiedName || ",")+ ";"
      )
    ;

  /** 
   * This nonterminal describes the invoked operation by a task.
   * There is exactly one ingoing message and at most one outgoing message.
   * It can specify error elements which may be returned.
   * An implementation of the operation can be referenced.
   */
  symbol Operation implements Method =
      Modifier "operation" Name "("
      "in" ":" in:Name@Notification
      (";" "out" ":" out:Name@Notification)? ")"
      ("throws" ":" error:Name@Notification)?
      ("{" "implementation" "=" impl:String ";" "}" | ";")
    ;

  // LoopCharacteristics describes an interface for standard and multi-instance loops. 
  interface LoopCharacteristics;

  // This nonterminal specifies the looping behavior for standart loops.
  StandardLoop implements LoopCharacteristics =
      type:["while"|"until"] ":" "[" loopCondition:Expression "]" 
      ("max" ":" loopMaximum:NatLiteral)?
    ;

  /** 
   * MILoop allows to create multiple instances of Activities. 
   * It can be executed in parallel or sequential.
   * It will only loop to the completion condition if one is specified.
   */
  MILoop implements LoopCharacteristics =
      "count" ":" LoopCardinality
      (type:["parallel"|"sequential"])?
      ("until" ":" "[" completionCondition:Expression "]")?
      MIImplicitEventBehavior?  
    ;

  /**
   * LoopDataInput describes a list of items that is used for multi-instance-activities.
   * Example: loopDataInput = ["Person1", "Person2", "Person3"]
   */
  astrule MILoop =
      loopDataInput: Name+
      loopDataOutput: Name+
    ;

  /** 
   * This nonterminal describes the behavior in case a trigger is thrown.
   * event:    defines the event trigger to be thrown
   * implicit: controls when the event trigger shall be thrown
   */
  MIImplicitEventBehavior =
      "event" ":" implicitEventDef:EventTrigger
      ("implicit" ":" ( when:["none"|"first"|"every"] | "[" complexCondition:Expression "]"))?
    ;

  // It controls the number of activities created by a MILoop.  
  LoopCardinality =
      count:NatLiteral
    | ("[" expression:Expression "]")
    | collection:Name // a collection-valued data object
    ;


  /*========================================================================*/
  /*=============================== GATEWAYS ===============================*/
  /*========================================================================*/

  // Gateway describes a flow control element that allows converging and diverging sequence flows. 
  symbol WFGateway implements FlowNode =
      Modifier direction:["split"|"merge"] type:GatewayType Name?
    ;
  
  /** 
   * It represents the number of activations at a complex gateway. 
   * The guard of an "complex" gateway refers to an activationCount.
   */
  astrule WFGateway = 
      activationCount:NatLiteral?
    ;
    
  /** 
   * There are different types of gateways.
   * "receive first": first event determines the path to follow 
   * "receive all":   waits for each event before following each outgoing path
   * "complex":       gateway is connected to a guard
   */
  GatewayType =
      [exclusive:"xor"]
    | [inclusive:"ior"]
    | [parallel: "and"]
    | ("receive" ":" [exclusiveEventBased:"first"])  
    | ("receive" ":" [ parallelEventBased:  "all"]) 
    | ["complex"] ("[" guard:Expression "]")       
    ;


  /*========================================================================*/
  /*================================ EVENTS ================================*/
  /*========================================================================*/

  /** 
   * Event defines something that happens during the course of workflow.  
   * They are either catching or throwing. 
   * throw: emits the event trigger 
   * catch: listens and waits for the event trigger to occur
   * Interrupting boundary events cancel the activity to which it is attached as it occurs. 
   * CompensationHandler: specifies compensating activity for boundary events
   * operation: MUST be specified for message task in an executable process
   * TODO: Discuss the use of optional for send and receive ?
   */  
  symbol WFEvent implements FlowNode =
      Modifier type:["start"|"end"]? "event" Name?
      (throw:["send"] | catch:["receive"] (["noninterrupt"])?)?
      trigger:EventTrigger?
      CompensationHandler?
      ( "{" ("operation" ":" operation:Name@Operation ";")? IOSet? "}" )?
    ;

  // This symbolrule indicated if the event is a boundary event.
  symbolrule WFEvent =
      boundary:boolean
    ;

  interface EventTrigger;

  // Below all BPMN triggers except the link trigger are listed.
  EventTriggerCancel       implements EventTrigger = "cancel";
  EventTriggerCompensate   implements EventTrigger = "compensate" (":" activity:Name)? ["async"]?;
  EventTriggerConditional  implements EventTrigger = "when"        ":" "[" Expression "]";
  EventTriggerTerminate    implements EventTrigger = "terminate";
  EventTriggerTimer        implements EventTrigger = "timer" ":" "[" condition:TimerCondition "]";
  EventTriggerMultiple     implements EventTrigger = ("one" | parallelMultiple:["all"]) 
                                                     "{" trigger:(EventTrigger || ",")+ "}";
  EventTriggerNotification implements EventTrigger = type:["error"|"escalate"|"message"|"signal"]
                                                     ":" Name@Notification ;

  /*
   * CompensationHandler designates compensating activity for a boundary event.
   * Compensation is done to, e.g., undo the effects of an activity.
   */
  CompensationHandler =
      "with" ":" activity:Name@WFActivity
    ;

  /*========================================================================*/
  /*============================= CONTROL FLOW =============================*/
  /*========================================================================*/

  // SequenceFlow defines a flow target. 
  SequenceFlow implements FlowElement =
      path:(FlowTarget || "->")+
    ;

  // TODO: Include this? Better coco?
  astrule SequenceFlow = path:FlowTarget min=2 ;

  // FlowBlock allows to specify a set of parallel sequence flow branches. 
  FlowBlock =
      "{" branch:(SequenceFlow || ",")+ "}"
    ;

  //TODO: Include this? Better coco?
  astrule FlowBlock = branch:SequenceFlow min=2 ;

  // Flow target references a flow element or defines an inline gateway, event or flow block. 
  FlowTarget =
      condition:FlowCondition?
      (element:MCQualifiedName | gateway:WFGateway | event:WFEvent | block:FlowBlock)
    ;

  // Either a flow target is preceded by a flow condition or it is a default sequence flow. 
  FlowCondition =
      "[" Expression "]"
    | default:["default"]
    ;

  /*========================================================================*/
  /*================================ DATA ==================================*/
  /*========================================================================*/

  /** 
   * DataObject represents a data object or a data store.
   * It has a name and a type.
   * TODO: Omit or force ";" here?
   */
  DataObject implements FlowElement, Variable =
      (type:["data"|"store"]) Name ":" MCType ";"
    ;


  /*========================================================================*/
  /*========================== I/O REQUIREMENTS ============================*/
  /*========================================================================*/

  // IORequirement is implemented by the classes "IOSet" and "IORule".
  interface IORequirement;

  // IOSet specifies an input or an output dataset. 
  IOSet implements IORequirement = dir:["in"|"out"] ":" DataSet ";" ;

  // IORule maps an input set to an output set. 
  IORule implements IORequirement =
      "io" ":" inputSet:DataSet "->" outputSet:DataSet ";"
    ;

  // Dataset consists set of input and/or output data. 
  DataSet  =  DataIO | "{" (DataIO || ",")* "}" ;

  /** 
   * DataIO specifies a data input or a data output.
   * [i]: the use of a collection-valued data input
   * "?": optional data input or output 
   * "!": data that can be produced or evaluated while executing
   * MCQualifiedName: name of the consumed or produced data element
   */
  DataIO =
      MCQualifiedName
      (loop:["[i]"])?  
      (":" MCType)?     
      (optional:["?"])?         
      (whileExecuting:["!"])? 
      ("as" alias:Name)?        
    ;


  /*========================================================================*/
  /*================================ MISC ==================================*/
  /*========================================================================*/
  
  symbol Notification implements FlowElement, Variable =
    kind:["error"|"escalation"|"message"|"signal"] Name ":" MCType ";" ;

  // TODO: Is this necessary?
  symbolrule Notification =
    isError: boolean
    isEscalation: boolean
    isMessage: boolean
    isSignal: boolean;

  nokeyword "timer";

}
