package de.monticore.bpmn;

grammar Workflow extends de.monticore.expressions.LambdaExpressions,
                         de.monticore.expressions.AssignmentExpressions,
                         de.monticore.expressions.CommonExpressions, 
                         de.monticore.timer.TimerConditions,
                         de.monticore.symbols.OOSymbols,
                         de.monticore.UMLModifier{

  WorkflowCompilationUnit =
      MCPackageDeclaration?
      MCImportStatement*
      WFProcess
    ;

  /**
    Workflow describes a textual representation of business process models
    that is based on BPMN 2.0 standard. It focuses on the modelling of business 
    processes, with the aim of providing a structured notation for the elements 
    of a workflow and their interactions.
    It covers (sub-)processes, lanes, events, gateways, various types of 
    activities, etc.

    The grammar builds on
    * LambdaExpressions, AssignmentExpressions and CommonExpressions
        to allow the definition of various kinds of conditions for the workflow execution
    * TimerConditions
        for the specification of different timing constraints
    * OOSymbols
        to include types, variables, and methods
    * UMLModifier
        to add access modifiers to processes and stereotype elements for conformance checking 
   */

  /*========================================================================*/
  /*=============================== PROCESS ================================*/
  /*========================================================================*/

  /**
   * FlowElement represents elements that can appear in a workflow process.
   * It includes lanes, activities, gateways, events, sequence flows, notifications etc.
   */ 
  interface FlowElement; 

  /** 
   * WFProcess describes a workflow which contains flow elements in any order.
   * A process has a modifier, a name and may contain I/O requirements.
   */
  symbol scope WFProcess =
      Modifier "process" Name "{"
        IORequirement*
        ( FlowElement ";" )*
      "}"
    ;

  /**
   * WFLane represents a sub-partition within a process which contains flow elements.
   * Every lane has a name and denotes for example a business function or a role.
   */
  WFLane implements FlowElement =
              "lane" Name "{"
                ( FlowElement ";" )*
              "}"
            ;


  /*========================================================================*/
  /*============================== ACTIVITIES ==============================*/
  /*========================================================================*/

  /** 
   * WFActivity denotes a unit of work performed within a business process.
   * An activity can be atomic or non-atomic.
   * This interface is implemented by the nontermials WFSubProcess, WFTask and WFCallActivity.
   */
  interface symbol WFActivity extends FlowElement =
      Modifier Name LoopCharacteristics?
    ;

  /**
   * This rule describes whether the corresponding activity compensates for another activity
     and, in this case, refers to one. 
   */
  symbolrule WFActivity =
    compensating:boolean
    compensates:WFActivitySymbol
  ;

  /**
   * WFSubprocess represents a sub-workflow that is modelled using tasks, gateways, events etc.  
   * "subprocess":  It describes an embedded subprocess.
   * "transaction": It models complex business scenarios and ensures that all parts are completed
                    successfully or are handled in case of failure. 
   * "adhoc":       It represents a collection of activities with no required sequence 
                    relationships. This means that the subprocess is flexible in its task execution.   
   */
  symbol scope WFSubProcess implements WFActivity =
      Modifier type:["subprocess" | "transaction" | "adhoc" ] Name
      AdHocCharacteristics?
      LoopCharacteristics?
      "{"
        ( FlowElement ";" )*
      "}"
    ;

  /** 
   * AdHocCharacteristics is required if it is an ad-hoc subprocess.
   * The condition defines when the execution should be completed.
   * It specifies whether activities should be executed in parallel or sequentially.
   * The "noninterrupt" tag indicates if the remaining activities should be cancelled 
     when the first one finishes.
   */
  AdHocCharacteristics =
      ("until" ":" "[" completionCondition:Expression "]")
      ( ["parallel"] (waitForRemainingInstances:["noninterrupt"])? | ["sequential"] )?
    ;

  /**
   * WFCallActivity calls another reusable process or global task. 
   * In this grammar, global tasks are modelled as processes containing only one task.
   * Example: A call activity "ShipOrder" calls a process named "ShippingProcess".
   * The activity may contain I/O requirements.
   * It can specify a boundary event to catch potential event triggers.
   */
  WFCallActivity implements WFActivity =
      Modifier "call-activity" Name "calls" ":" calledElement:Name@WFProcess
      LoopCharacteristics?
      (   "{"
            IORequirement*        
            ("boundary" boundaryEvent:WFEvent)*
          "}" )?
    ;

  /** 
   * WFTask represents an atomic activity within a workflow.
   * "service": It is automated by software and can use external applications.
   * "send":    It sends a message to an external system or participant.
   * "receive": It waits for an incoming message from an external system or participant.
   * "user":    It is performed by a person with the support of software.
   * "manual":  It is performed physically without the aid of software.
   * "rule":    It is used to interact with a business rule engine.
   * "script":  It executes the script directly within the process model.
   * A task can specify a boundary event to catch potential event triggers.
   */
  WFTask implements WFActivity =
      Modifier type:["service"|"send"|"receive"|"user"|"manual"|"rule"|"script"]? "task" Name
      LoopCharacteristics?
      (   "{"
             TaskTypeAttributes?
             IORequirement*
             ("boundary" boundaryEvent:WFEvent)*
          "}" )?
    ;
  
  /**
   * TaskTypeAttributes describes potential attributes for all types of tasks.
   * "service": It contains the used webservice and optionally the operation triggered by the task.
   * "send":    It contains the used webservice, a message and the operation triggered by the task.
   * "receive": It contains the used webservice, a message and the operation triggered by the task.
   * "user":    It only contains the used webservice.   
   * "manual":  It only contain the needed resources.
   * "rule":    It only contains the used webservice.
   * "script":  It contains the used script and the format of the script.
   */ 
  TaskTypeAttributes =
      (
          // valid Strings are ##unspecified, ##webservice or a URI 
          ("webservice" "=" webservice:String ";")

          // references an operation
          ("operation" ":" operation:Name@Operation ";")?

          // used in send and receive tasks for communication 
          ("message" ":" message:Name@Notification ";")?
        |
          // format of the script and a script that can be run when a task is performed 
          "script" "(" scriptFormat:String ")" "=" "{" script:String "}" ";"
        |
          // human resources or other resources assigned to tasks 
          "resources" ":" resources:(MCQualifiedName || ",")+ ";"
      )
    ;

  /** 
   * This nonterminal describes the invoked operation by a task.
   * There is exactly one ingoing message and at most one outgoing message.
   * It can specify error elements which may be returned.
   * An implementation of the operation can be referenced.
   */
  symbol Operation implements Method =
      Modifier "operation" Name "("
      "in" ":" in:Name@Notification
      (";" "out" ":" out:Name@Notification)? ")"
      ("throws" ":" error:Name@Notification)?
      ("{" "implementation" "=" impl:String ";" "}" | ";")
    ;

  // LoopCharacteristics describes an interface for standard and multi-instance loops. 
  interface LoopCharacteristics;

  /**
   * StandardLoop specifies the looping behavior for normal loops.
   * Along with a loop condition, a while or do-while loop can be specified.
   * It is also possible to set the maximum number of iterations.
   */ 
  StandardLoop implements LoopCharacteristics =
      type:["while"|"until"] ":" "[" loopCondition:Expression "]" 
      ("max" ":" loopMaximum:NatLiteral)?
    ;

  /** 
   * MILoop allows to create multiple instances of activities. 
   * The loops can be executed in parallel or sequentially.
   * It will only loop to the completion condition if one is specified.
   */
  MILoop implements LoopCharacteristics =
      "count" ":" LoopCardinality
      (type:["parallel"|"sequential"])?
      ("until" ":" "[" completionCondition:Expression "]")?
      MIImplicitEventBehavior?  
    ;

  /**
   * LoopDataInput describes a list of items that is used for multi-instance-activities.
   * Example: loopDataInput = ["Person1", "Person2", "Person3"]
   */
  astrule MILoop =
      loopDataInput: Name+
      loopDataOutput: Name+
    ;

  /** 
   * MIImplicitEventBehavior describes if an event shall be thrown after an instance completes.
   * The implimplicitEventDef defines the event trigger to be thrown.
   * The trigger can be thrown at a specific time point or depending on a condition.
   */
  MIImplicitEventBehavior =
      "event" ":" implicitEventDef:EventTrigger
      ("implicit" ":" ( when:["none"|"first"|"every"] | "[" complexCondition:Expression "]"))?
    ;

  /**
   * LoopCardinality controls the number of activities created by a MILoop. 
   * It can be an integer value, an expression that resolves to an integer,
     or a collection-valued data object.
   */  
  LoopCardinality =
      count:NatLiteral
    | ("[" expression:Expression "]")
    | collection:Name 
    ;


  /*========================================================================*/
  /*=============================== GATEWAYS ===============================*/
  /*========================================================================*/

  /**
   * WFGateway describes a flow control element.
   * It allows for converging and diverging sequence flows.
   * There are several types of gateways.
   */ 
  symbol WFGateway implements FlowElement =
      Modifier direction:["split"|"merge"] type:GatewayType Name?
    ;
  
  /** 
   * It represents the number of activations at a complex gateway. 
   * The guard of an "complex" gateway refers to an activationCount.
   */
  astrule WFGateway = 
      activationCount:NatLiteral?
    ;
    
  /** 
   * There are different types of gateways.
   * "receive first": The first event determines the path to follow. 
   * "receive all":   It waits for each event before following each outgoing path.
   * "complex":       The gateway is connected to a guard.
   */
  GatewayType =
      [exclusive:"xor"]
    | [inclusive:"ior"]
    | [parallel: "and"]
    | ("receive" ":" [exclusiveEventBased:"first"])  
    | ("receive" ":" [ parallelEventBased:  "all"]) 
    | ["complex"] ("[" guard:Expression "]")       
    ;


  /*========================================================================*/
  /*================================ EVENTS ================================*/
  /*========================================================================*/

  /** 
   * WFEvent defines an occurrence that happens during the course of workflow.  
   * It is either catching or throwing. Throw events emit the trigger,
     whereas catch events listen for the trigger to occur.
   * Interrupting boundary events cancel the activity to which they are attached. 
   * An operation must be specified for message tasks in an executable process.
   */  
  symbol WFEvent implements FlowElement =
      Modifier type:["start"|"end"]? "event" Name?
      (throw:["send"] | catch:["receive"] (["noninterrupt"])?)?
      trigger:EventTrigger?
      CompensationHandler?
      ( "{" ("operation" ":" operation:Name@Operation ";")? IOSet? "}" )?
    ;

  // This rule indicates if an event is a boundary event.
  symbolrule WFEvent =
      boundary:boolean
    ;

  // This interface is implemented by all event triggers in this grammar.
  interface EventTrigger;

  // Below all triggers of the BPMN except the link trigger are listed.
  EventTriggerCancel       implements EventTrigger = "cancel";
  EventTriggerCompensate   implements EventTrigger = "compensate" (":" activity:Name)? ["async"]?;
  EventTriggerConditional  implements EventTrigger = "when"        ":" "[" Expression "]";
  EventTriggerTerminate    implements EventTrigger = "terminate";
  EventTriggerTimer        implements EventTrigger = "timer" ":" "[" condition:TimerCondition "]";
  EventTriggerMultiple     implements EventTrigger = ("one" | parallelMultiple:["all"]) 
                                                     "{" trigger:(EventTrigger || ",")+ "}";
  EventTriggerNotification implements EventTrigger = type:["error"|"escalate"|"message"|"signal"]
                                                     ":" Name@Notification ;

  /*
   * CompensationHandler designates an compensating activity for a boundary event.
   * Compensation is done to, e.g., undo the effects of an activity.
   */
  CompensationHandler =
      "with" ":" activity:Name@WFActivity
    ;


  /*========================================================================*/
  /*============================= CONTROL FLOW =============================*/
  /*========================================================================*/

  // SequenceFlow defines a series of flow targets. 
  SequenceFlow implements FlowElement =
      path:(FlowTarget || "->")+
    ;

  // FlowBlock allows to specify a set of parallel branches in a sequence flow. 
  FlowBlock =
      "{" branch:(SequenceFlow || ",")+ "}"
    ;

  /**
   * FlowTarget references a flow element or flow block or defines an inline gateway or event. 
   * A flow restriction condition can also be set.
   */
  FlowTarget =
      condition:FlowCondition?
      (element:MCQualifiedName | gateway:WFGateway | event:WFEvent | block:FlowBlock)
    ;

  // Either a flow target is preceded by a flow condition or it is a default sequence flow. 
  FlowCondition =
      "[" Expression "]"
    | default:["default"]
    ;


  /*========================================================================*/
  /*================================ DATA ==================================*/
  /*========================================================================*/

  /** 
   * This nonterminal represents a data object or a data store.
   * It has a name and a type.
   */
  DataObject implements FlowElement, Variable =
      type:["data"|"store"] Name ":" MCType 
    ;


  /*========================================================================*/
  /*========================== I/O REQUIREMENTS ============================*/
  /*========================================================================*/

  // IORequirement is implemented by the nontermials IOSet and IORule.
  interface IORequirement;

  // IOSet specifies an input or an output dataset. 
  IOSet implements IORequirement = dir:["in"|"out"] ":" DataSet ";" ;

  // IORule maps an input set to an output set. 
  IORule implements IORequirement =
      "io" ":" inputSet:DataSet "->" outputSet:DataSet ";"
    ;

  // Dataset consists of one or more input or output data.
  DataSet  =  DataIO | "{" (DataIO || ",")* "}" ;

  /** 
   * DataIO specifies a data input or a data output.
   * MCQualifiedNam defines the name of the consumed or produced data element
   * [i]: The tag indicates the use of a collection-valued data input.
   * "?": It marks the input or output data as optional.
   * "!": It specifies that the data can be produced or evaluated while executing.
   */
  DataIO =
      MCQualifiedName
      (loop:["[i]"])?  
      (":" MCType)?     
      (optional:["?"])?         
      (whileExecuting:["!"])? 
      ("as" alias:Name)?        
    ;


  /*========================================================================*/
  /*================================ MISC ==================================*/
  /*========================================================================*/
  
  /**
   * Notification allows for the definition of different kinds of messages.
   * Every notification has a name and a type.
   */
  symbol Notification implements FlowElement, Variable =
    kind:["error"|"escalation"|"message"|"signal"] Name ":" MCType ;

  // This rule adds methods to easily distinguish between the types of a notification.
  symbolrule Notification =
    isError: boolean
    isEscalation: boolean
    isMessage: boolean
    isSignal: boolean;

  nokeyword "timer";

}
