package de.monticore.bpmn;

grammar Workflow extends de.monticore.ocl.OCL, // todo: common, assigmnement, lammbda?
                         de.monticore.expressions.TimeExpressions, // todo: integrieren
                         de.monticore.symbols.OOSymbols,
                         de.monticore.UMLModifier{  //todo: ggf. durch Type-Symbols ersetzen und Modifier importieren

  /* Expression Language, e. g. OCL */

  WorkflowCompilationUnit =
      MCPackageDeclaration?
      MCImportStatement*
      Process
    ;
    

  /*========================================================================*/
  /*=============================== PROCESS ================================*/
  /*========================================================================*/

  /* represents a model element that can appear in a Process e.g. Activity, Gateway, Event ... */
  interface FlowElement;

  /**
   * contains a superset of FlowElements e.g. Process, SubProcess 
   * todo: low priority? remove? 
   */
  interface FlowElementContainer = Name FlowElement*;

  /* represents a Process which contains Lanes and FlowElements in any order */
  symbol scope Process implements FlowElementContainer =
      "process" 
      Name
      // todo: Modifier? Is this correct?
      {next("public","private","default")}? (Modifier | "default")
      "{"
        IOSpecification
        (   Lane        
          | FlowElement
        )*
      "}"
    ;

  /**
   * sub-partition within a Process which contains FlowElements and sub-lanes
   * a lane denotes for example a business function or a role
   */
  symbol Lane =
      "lane" Name
      "{"
        (   childLane:Lane  
          | FlowElement
        )*
      "}"
    ;
  astrule Lane =
      parentLane:String?
    ;


  /*========================================================================*/
  /*============================== ACTIVITIES ==============================*/
  /*========================================================================*/

  /** 
   * denotes an unit of work performed within a Business Process
   * can be atomic or non-atomic 
   */
  interface symbol Activity extends FlowElement =
      Name
      CompensationHandler?
      LoopCharacteristics?
    ;

  /** 
   * represents a SubProcess whose internal details are modelled using Activities, Events ... 
   * "subprocess":   describes an embedded subprocess 
   * "transaction":  models complex business scenarios -> ensuring all parts completed successfully or are handled in case of failure 
   * "adhoc":        collection of activities with no required sequence relationships -> flexibility in task execution   
   */
  symbol scope SubProcess implements Activity, FlowElementContainer  =
      Name
      type:["subprocess" | "transaction" | "adhoc" ]
      AdHocCharacteristics?
      CompensationHandler?
      LoopCharacteristics?
      "{"
        // IOSpecification not allowed by BPMN standard, we include it here to enable a suitable error message
        IOSpecification 
        (   Lane        
          | FlowElement
        )*
      "}"
    ;

  /** 
   * flag that indicates whether it is an "event sub-process"
   * false: normal subprocess
   * true: a subprocess with a separate start event and a start trigger
   */
  astrule SubProcess =
      triggeredByEvent:boolean  
    ;

  /** 
   * AdHocCharacteristics is needed in case it is an Ad-Hoc Sub Process 
   * an adhoc subprocess does not require any Sequence relationships 
   */
  AdHocCharacteristics =
      ("until" ":" "[" completionCondition:Expression "]")
      (   "parallel" (waitForRemainingInstances:["noninterrupt"])? 
        | ["sequential"]
      )?
    ;

  /* Non-decomposable Activity */
  interface symbol scope AtomicActivity extends Activity =
      Name
      IOSpecification?
      (boundaryEvent:Event)* // used for intermediate catch events
    ;

  /* allows a process to invoke another reusable process or task */
  CallActivity implements AtomicActivity =
      "task"
      Name
      // todo: better naming calledElement? @Task (global)?
      "template" ":" template:Name@Process 
      CompensationHandler?
      LoopCharacteristics?
      (   "{"
            IOSpecification         // must match the I/O requirements of the called element
            (boundaryEvent:Event)*
          "}"
        | ";"
      )
    ;

  /** 
   * AtomicActivity within a process flow 
   * "service": automated by software and can use external applications
   * "send":    sending message to an external system or participant
   * "receive": waiting for an incoming message from an external system or participant
   * "user":    performed by a person with the support of software
   * "manual":  performed physically without the aid of software
   * "rule":    BusinessRule? used to interact with a business rule engine
   * "script":  execution of script directly within the process model
   */
  Task implements AtomicActivity =
      "task"
      Name
      type:["service" | "send" | "receive" | "user" | "manual" | "rule" | "script"]?
      TaskTypeAttributes?
      CompensationHandler?
      LoopCharacteristics?
      (   "{"
            IOSpecification
            (boundaryEvent:Event)*
          "}"
        | ";"
      )
    ;

  //todo: für später ggf. alle Attribute einfach optional in Task aufführen?
  interface TaskTypeAttributes;
  /* service: used webservice and the operation triggered by the task  */
  /* send:    used webservice, message and the operation triggered by the task  */
  /* receive: used webservice, message and the operation triggered by the task  */
  /* user: used webservice and renderings  */
  /* manual: needed resources  */
  /* rule: used webservice  */
  /* script: used script and the format of the script  */


  /* TaskTypeAttribute for "send" and "receive" */
  TaskSendReceiveTypeAttributes implements TaskTypeAttributes =
      "message" ":" message:Name@Notification
    ;

  /* 
   * describes a set of activities that are outside of the process flow, similar to exception handling
   * Why not linked to boundaryEvent? -> can also be the start event of a subprocess 
   * Example: a task "BookOffering" is compensated by the service task "CancelBooking"
   */
  CompensationHandler =
      "compensate" ":" activity:Name@Activity
    ;

  /* interface for StandardLoop and MILoop */
  interface LoopCharacteristics;

  /* looping behavior based on loopCondition */
  StandardLoop implements LoopCharacteristics =
      (testBefore:["while"] | "until") ":" "[" loopCondition:Expression "]" 
      ("max" ":" loopMaximum:NatLiteral)?
    ;

  /** 
   * allows to create multiple instances of Activities 
   * can be executed parallel or sequential 
   * will only loop until completionCondition
   */
  MILoop implements LoopCharacteristics =
      "count" ":" LoopCardinality
      ("parallel" | "sequential")?
      ("until" ":" "[" completionCondition:Expression "]")?
      MIImplicitEventBehavior?  
    ;

  /**
   * todo: do we need this? then we may also need loopDataInputRef, loopDataOutputRef?
   * loopDataInput describes a single item of the collection stored in loopDataInputRef
   * example: loopdataInputRef = ["Person1", "Person2", "Person3"]
   *          loopDataInput will contain on of these names for the corresponding instance
   */
  astrule MILoop =
      loopDataInput: Name
      loopDataOutput:Name
    ;

  /** 
   * event: defines the EventTrigger to be thrown
   * implicit: controls when the Eventtrigger shall be thrown
   */
  MIImplicitEventBehavior =
      "event" ":" implicitEventDef:EventTrigger    
      ("implicit" ":" (["none"] | ["first"] | ["every"] | "[" complexCondition:Expression "]"))?
    ;

  /* controls the number of Activities created by a MILoop */ 
  LoopCardinality =
      count:NatLiteral
    | ("[" expression:Expression "]")
    | collection:Name // a collection-valued data object, do we need this option?
    ;


  /*========================================================================*/
  /*=============================== GATEWAYS ===============================*/
  /*========================================================================*/

  /** 
   * describes a flow control element that allows converging and diverging sequence flows
   * todo: different naming for GatewayDirection? Unspecified, Converging, Diverging 
   */
  symbol Gateway implements FlowElement =
      direction:["split" | "merge"]
      type:GatewayType
      Name?
      ";"
    ;
    
  /** possible Types of Gateways 
   * "receive first": first event determines the path to follow 
   * "receive all":  waits for each event before following each outgoing path
   * "complex": Gateway is connected to a guard
   */
  GatewayType =
      [exclusive:"xor"]
    | [inclusive:"ior"]
    | [parallel: "and"]
    | ("receive" ":" [exclusiveEventBased:"first"])  
    | ("receive" ":" [ parallelEventBased:  "all"]) 
    | ["complex"] ("[" guard:Expression "]")       
    ;


  /*========================================================================*/
  /*================================ EVENTS ================================*/
  /*========================================================================*/

  /** 
   * defines something that happens during the course of business process  
   * Events are either catching or throwing 
   * throw: emits the event trigger 
   * catch: listens and waits for the event trigger to occur
   * interrupting boundary event cancels the activity to which it is attached as it occurs 
   * boundary: is marked in case it is attached to an Activity
   */  
  symbol Event implements FlowElement =
      (boundary:["<<boundary>>"])?
      "event" 
      type:["start" | "end"]?
      Name?
      behavior:[ throw:"send" | catch:"receive" ] //todo: Do we need "noninterrupt" for catch events?
      trigger:EventTrigger?
      (   "{"
            (input:IRequirement | output:ORequirement)?
          "}"
        | ";"
      )
    ;

  interface EventTrigger;

  /* all BPMN triggers except the link trigger */
  EventTriggerCancel       implements EventTrigger = "cancel";
  EventTriggerCompensate   implements EventTrigger = "compensate" (":" activity:Name)? ["async"]?;
  EventTriggerConditional  implements EventTrigger = "when"        ":" "[" Expression "]";
  EventTriggerTerminate    implements EventTrigger = "terminate";
  EventTriggerTimer        implements EventTrigger = "timer"       ":" "[" expression:TimeExpression "]";
  EventTriggerMultiple     implements EventTrigger = ("one" | parallelMultiple:["all"]) "{" trigger:(EventTrigger || ",")+ "}";
  EventTriggerNotification implements EventTrigger = ("error" | "escalate" | "message" | "signal") ":" Name@Notification ;

  /*========================================================================*/
  /*============================= CONTROL FLOW =============================*/
  /*========================================================================*/

  /* todo: force the naming of FlowElements? eliminates the need for the flow block*/

  /* models the SequenceFlow by chaining FlowTargets */
  SequenceFlow implements FlowElement =
      path:(FlowTarget || "->")+
      ";"
    ;

  /* specifies a set of parallel sequence flow branches */
  FlowBlock =
      "{" branch:(FlowBranch || ",")+ "}"
    ;

  /* similar to the production of SequenceFlow but without the ";" */
  FlowBranch =
      path:(FlowTarget || "->")+
    ;

  /* reference a FlowElement using its name or create a block structure */
  FlowTarget =
      condition:FlowCondition?
      (   nodeRef:MCQualifiedName   // reference flow node at process level
        // leads to error from Antlr due to left-recursive production
        // we can no longer specify InlineFlowElements, so we can ignore this option?
        // "| node:FlowElement"  
        | block:FlowBlock
      )
    ;

  /* Either a FlowTarget is preceded by a FlowCondition or it is a default sequence flow */
  FlowCondition =
      "[" Expression "]"
    | default:["<<default>>"]
    ;

  /*========================================================================*/
  /*================================ DATA ==================================*/
  /*========================================================================*/

  /* represents a data object or data store */
  symbol DataObject implements FlowElement, Variable =
      ("data" | ["store"]) Name ":" MCType ";"
    ;


  /*========================================================================*/
  /*========================== I/O REQUIREMENTS ============================*/
  /*========================================================================*/

  /* todo: distinction necessary? remove? */
  IOSpecification = IORequirement* ;

  /* input requirement, output requirement or input-output rule */
  interface IORequirement;

  /* specifies an input set */
  IRequirement implements IORequirement = "in"  ":" inputSet:DataSet  ";" ;

  /* specifies an output set */
  ORequirement implements IORequirement = "out" ":" outputSet:DataSet ";" ;

  /* maps an input set to an output set and optionally assigns an operationName */
  IORule implements IORequirement =
      "io" (operationName:Name)? ":" inputSet:DataSet "->" outputSet:DataSet ";"
    ;

  /* Set of input and output data */
  DataSet  =  DataIO | "{" (DataIO || ",")* "}" ;

  /** 
   * specifies data input or data output 
   * [i]: the use of a collection-valued data input
   * "?": optional data input or output
   * "!": data that can be produced or evaluated while executing
   */
  DataIO =
      MCQualifiedName   // name of the consumed or produced data element
      (loop:["[i]"] {noSpace()}?)?  
      (":" MCType)?     
      (
        (   optional:["?"]         
          | whileExecuting:["!"]   
        )
        {noSpace()}?
      )?
      ("as" alias:Name)?        
    ;


  /*========================================================================*/
  /*================================ MISC ==================================*/
  /*========================================================================*/

  symbol Notification implements FlowElement, Variable =
    kind:["error"|"escalation"|"message"|"signal"] Name ":" MCType ";" ;

  symbolrule Notification =
    isError: boolean
    isEscalation: boolean
    isMessage: boolean
    isSignal: boolean;

  nokeyword "timer";

}
