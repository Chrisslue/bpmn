/* (c) https://github.com/MontiCore/monticore */
package de.monticore.bpmn;

component grammar TimerConditions extends de.monticore.literals.MCCommonLiterals
{

  /**
     This component grammar defines productions for the specification of
     timer based conditions primarily used by EventTriggerTimer in the
     Workflow DSL to trigger WFEvents. It extends MCCommonLiterals to make
     use of existing numeric literals.
     TODO: Use custom DateTime DSL for Date and Time concepts.
   */

  // This interface is implemented by each specific timer condition.
  interface TimerCondition;

  // This condition is used to specify a trigger at a specific time of day.
  AtTimeCondition implements TimerCondition =
      "at" Time
    ;

  /*
   * This condition specifies a trigger for a specific date, and optionally
     at a specific time.
   */
  OnDateCondition implements TimerCondition =
      "on" Date AtTimeCondition?
    ;

  /*
   * This condition specifies a trigger that occurs after a specified period
     of time.
   */
  AfterPeriodCondition implements TimerCondition =
      "after" period:Period
    ;

  /**
   * This condition is repeatedly triggered everytime a specified period of
     time elapses.
   * Optionally a starting date and time can be specified. 
   * Additionally, the number of occurrences can be limited.
   */
  EveryTimeCondition implements TimerCondition =
      ("start" start:OnDateCondition ",")?
      (times:NatLiteral "times")? "every" period:Period
    ;

  /* This is used to allow the specification of a ISO8701 cron expression.
   * The format is enforced via the TOP-mechanism.
   */
  CronCondition implements TimerCondition =
      "cron" value:String
    ;

  /**
   * This nonterminal specifies a point in time that includes hours and
     minutes, with seconds as an additional option.
   */ 
  Time = {noSpace(2,3,4)}?
      hours:NatLiteral ":" minutes:NatLiteral
      ({noSpace(4,5)}? ":" seconds:NatLiteral)?
    ;

  /*
   * This nonterminal defines a specific date that includes the year,
     the month, and the day.
   */
  Date = {noSpace(2,3,4,5)}?
      year:NatLiteral "-" month:NatLiteral "-" day:NatLiteral
    ;

  /* This nonterminal allows for the specification of ISO8701 time periods,
     e.g., "P2Y3M2W1DT2H13M20S".
   * The format is enforced via the TOP-mechanism.
   */
  Period = value:Name;

}
