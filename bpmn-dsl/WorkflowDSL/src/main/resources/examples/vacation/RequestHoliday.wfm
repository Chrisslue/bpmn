 /* (c) https://github.com/MontiCore/monticore */ 
package de.monticore.bpmn.examples;

import de.monticore.bpmn.cds.Domain.*;


process RequestHoliday {

  lane Requester {
    CoordinateInternally,
    FillHolidayCardEntry,
    SubmitHolidayRequest,
    ChooseToComplain,
    ChooseToRetry
  }

  lane Superior {
    CheckHolidayRequest,
    AcknowledgeHolidayRequest
  }

  data holidayCard:HolidayCard;

  event Start <<start>>;

  Start -> CoordinateInternally;

  subprocess CoordinateInternally {
    task manual CoordinateWithColleagues;
    task FindSubstitute;
  }

  CoordinateInternally -> FillHolidayCardEntry;

  task user FillHolidayCardEntry {
    io: {} -> { holidayCard };
  }

  FillHolidayCardEntry -> SubmitHolidayRequest;

  task SubmitHolidayRequest;

  subprocess CheckHolidayRequest {
    data contract:Contract;

    event Start <<start>>;

    Start -> ValidateLeaveDaysAndCheckWaitingPeriod;

    split parallel ValidateLeaveDaysAndCheckWaitingPeriod; // naming parallel gateways is awkward

    ValidateLeaveDaysAndCheckWaitingPeriod -> ValidateLeaveDays;
    ValidateLeaveDaysAndCheckWaitingPeriod -> CheckWaitingPeriod;

    task ValidateLeaveDays {
      io: {holidayCard} -> {};
    }

    ValidateLeaveDays -> IsRequestValid;

    split exclusive IsRequestValid;

    IsRequestValid -> ValidateLeaveDaysAndCheckWaitingPeriodJoin [true];
    IsRequestValid -> Terminate1 [false];

    event Terminate1 throw terminate <<end>>;

    task CheckWaitingPeriod {
      io: {contract} -> {};
    }

    CheckWaitingPeriod -> IsRequesterEligibleForHoliday;

    split exclusive IsRequesterEligibleForHoliday;

    IsRequesterEligibleForHoliday -> ValidateLeaveDaysAndCheckWaitingPeriodJoin [true];
    IsRequesterEligibleForHoliday -> Terminate2 [false];

    event Terminate2 throw terminate <<end>>;

    join parallel ValidateLeaveDaysAndCheckWaitingPeriodJoin;

    ValidateLeaveDaysAndCheckWaitingPeriodJoin -> End;

    event End <<end>>;
  }

  CheckHolidayRequest -> IsHolidayRequestAccepted;

  split exclusive IsHolidayRequestAccepted;

  IsHolidayRequestAccepted -> AcknowledgeHolidayRequest [true];
  IsHolidayRequestAccepted -> ChooseToRetry [false];

  task AcknowledgeHolidayRequest {
    io: {holidayCard} -> {holidayCard};
  }

  AcknowledgeHolidayRequest -> End1;

  event End1 <<end>>;

  task ChooseToRetry;

  ChooseToRetry -> Retry;

  split exclusive Retry;

  Retry -> End2 [false];
  Retry -> IsEscalationPossible [true];

  event End2 <<end>>;

  split exclusive IsEscalationPossible;

  IsEscalationPossible -> CoordinateInternally;
  IsEscalationPossible -> ChooseToComplain [3 > 3];

  task ChooseToComplain;

  ChooseToComplain -> Complain;

  split exclusive Complain;

  Complain -> CoordinateInternally [false];
  Complain -> SendComplaint [true];

  task send:complaint SendComplaint;

  message complaint:Complaint;

  SendComplaint -> ReceiveAnswer;

  task receive:answerToComplaint ReceiveAnswer;

  message answerToComplaint:ComplaintResponse;

  ReceiveAnswer -> End3;

  event End3 <<end>>;
}