package examples.vacation;

classdiagram Vacation {

  class Contract {
    Date hiringDate;
  }

  class HolidayCard;

  class HolidayCardEntry {
    Date start;
    Date end;
    /int workingDays;
    /int remainingLeaveDays;
    String substitute;
    boolean approved;
  }

  association entries [1] HolidayCard -> HolidayCardEntry [*] <<ordered>>;

  class Complaint {
    String content;
  }

  class ComplaintResponse {
    String content;
  }

}