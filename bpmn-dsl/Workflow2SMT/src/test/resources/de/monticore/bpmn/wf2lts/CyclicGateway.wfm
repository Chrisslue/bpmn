package de.monticore.wf2lts;

process CyclicGateway {


  task A;
  task B;
  task C;
  split xor GatewaySplit;
  merge xor GatewayMerge;

  event start Start;
  event end End;

  Start -> A;
  A -> GatewayMerge;
  GatewayMerge -> B;
  B -> GatewaySplit;
  GatewaySplit -> GatewayMerge;
  GatewaySplit -> C -> End;

}