package de.monticore.wf2smt;

process Prototype {

  task A;
  task B;
  split xor GatewaySplit;
  merge xor GatewayJoin;
  event start -> GatewaySplit;
  GatewaySplit -> A -> T -> GatewayJoin;
  GatewaySplit -> B -> GatewayJoin;
  GatewayJoin -> event end;

  subprocess T {
      task G;
      event start Start;
      event end End;
       Start -> G -> End;
  }

}