package de.monticore.bpmn.cds;


classdiagram Domain {

    class Contract {
      public int version;
    }

    class DomainUser;

    association [1] DomainUser -> Contract [*];

    class Report {
      String result;
      String details;
    }

    class LeaveCard;

    class LeaveEntry {
      /int workingDays;
      /int remainingLeaveDays;
      DomainUser substitute;
      boolean valid;
      boolean approved;
    }

    association entries [1] LeaveCard -> LeaveEntry [*]; // <<ordered>>;

    association [1] LeaveCard -> DomainUser [1];

    class MedicalCertificate {
      String description;
    }

}
