package de.monticore.bpmn.conformance.sleProject;

classdiagram TimeManagement {

  public class LocalDateTime;

  public class TimeSlot {
    public LocalDateTime startTime;
    public String project;
    public String workPackage;

    public boolean hasEndTime();
    public boolean isVacation();
    public boolean endTimeBeforeStartTime();
    public boolean insufficientPermissions();
    public boolean durationGreaterThanTenHours();
  }

  association endTime [1] TimeSlot -> LocalDateTime [0..1];

  public class TimeSlotList;

  association slots [1] TimeSlotList -> TimeSlot [*];

  public class Database;

  public class VacationRequestDecision {
    public boolean approved;

    public boolean isApproved();
  }

  public class ErrorMessage {
    public String message;
  }

}
