
process  TaskNotIncarnated {

  start event Start;
  end event Done;

  task  Introduction;
  task  Main;
  task Conclusion;
  task Draft;
  task Research;
  task Review;

  merge xor StartIteration;
  split xor EndIteration;
  split xor SplitWork;
  merge and MergeWork;


  Start -> Research-> Draft -> StartIteration -> SplitWork -> Main -> MergeWork -> Review -> EndIteration -> Done;
                                                 SplitWork -> Conclusion -> MergeWork;
               EndIteration -> StartIteration;


}
