package de.monticore.bpmn.conformance.sleProject;

import de.monticore.bpmn.conformance.sleProject.TimeManagement.*;
process TimeManagement {

  data slots:TimeSlotList;
  data chosenSlot:TimeSlot;
  data slot:TimeSlot;
  data decision:VacationRequestDecision;
  data error:ErrorMessage;

  store database:Database;

  error invalidInput:ErrorMessage;
  error persistenceFailed:ErrorMessage;
  signal abortRequested:boolean;
  signal vacationApproved:boolean;

  start event UserLoggedIn;
  end event UserLoggedOut;

  user task OpenDashboard {
    webservice = ##webservice;
    in database -> out slots;
  }

  UserLoggedIn -> OpenDashboard -> UserLoggedOut;
}
