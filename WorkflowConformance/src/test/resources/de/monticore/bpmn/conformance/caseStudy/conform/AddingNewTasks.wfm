 /* (c) https://github.com/MontiCore/monticore */
process AddingNewTasks {

  start event Start;
  end event Done;

  task  Introduction;
  task  ConceptOfNewFeatures;
  task  Main;
  task Conclusion;
  task Draft;
  task Implementation;
  task Research;
  task Review;

  merge xor StartIteration;
  split xor EndIteration;
  split and SplitWork;
  merge and MergeWork;


  Start ->
     Research ->
       Draft ->
          StartIteration ->
            ConceptOfNewFeatures -> SplitWork -> Introduction   -> MergeWork;
                                    SplitWork -> Implementation -> MergeWork;
                                    SplitWork -> Main           -> MergeWork -> Review -> EndIteration -> Done;
                                    SplitWork -> Conclusion     -> MergeWork;
                                                                                          EndIteration -> StartIteration;


}
