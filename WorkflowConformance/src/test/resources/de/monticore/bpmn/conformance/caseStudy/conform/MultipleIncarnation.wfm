 /* (c) https://github.com/MontiCore/monticore */
process MultipleIncarnation {

  start event Start;
  end event Done;

  task Research;
  task Draft;
  task Introduction;
  task Conclusion;
  task Review;

  <<ref="Main">> task Discussion;
  <<ref="Main">> task CaseStudy;
  <<ref="Main">> task Concept;
  <<ref="Main">> task Implementation;


  merge xor StartIteration;
  split xor EndIteration;
  split and SplitWork;
  merge and MergeWork;

  Start ->
     Research ->
       Draft ->
          StartIteration -> SplitWork -> Introduction   -> MergeWork;
                            SplitWork -> Implementation -> MergeWork;
                            SplitWork -> Concept -> MergeWork;
                            SplitWork -> Conclusion -> MergeWork -> CaseStudy
                                                                       -> Discussion
                                                                             -> Review
                                                                                  -> EndIteration
                                                                                       -> Done;
  EndIteration -> StartIteration;

}
