# Ensure consistent line endings across platforms
* text=auto

# Force LF for all source and model files
*.java text eol=lf
*.mc4  text eol=lf
*.wfm  text eol=lf
*.md   text eol=lf
*.xml  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.json text eol=lf
*.cd   text eol=lf
*.cdsym text eol=lf

# Binary files — no line ending conversion
*.jar  binary
*.png  binary
*.jpg  binary
*.pdf  binary
*.class binary
