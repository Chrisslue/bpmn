package de.monticore.bpmn.cocos.activities.invalid;

import de.monticore.bpmn.cds.Domain.*;

process CompensationActivityHasNoIncomingOrOutgoingFlow {

  task T1;
  task T3;

  task T2 {
    boundary event E1 with T1;
    }

  task T4 {
      boundary event E1 with T3;
   }

  T1 -> T3 -> T2;

}