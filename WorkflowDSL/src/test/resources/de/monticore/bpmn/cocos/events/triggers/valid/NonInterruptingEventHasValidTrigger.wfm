package de.monticore.bpmn.cocos.events.triggers.valid;

import de.monticore.bpmn.cds.Domain.*;

process NonInterruptingEventHasValidTrigger {

  message msg:LeaveCard;

  subprocess S1 {
    start event E1 catch noninterrupt message msg;
    end event E2;

    E1 -> E2;
  }

}
