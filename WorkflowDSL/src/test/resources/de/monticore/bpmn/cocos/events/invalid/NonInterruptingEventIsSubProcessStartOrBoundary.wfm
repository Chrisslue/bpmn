package de.monticore.bpmn.cocos.events.invalid;

import de.monticore.bpmn.cds.Domain.*;

process NonInterruptingEventIsSubProcessStartOrBoundary {

  message msg:Contract;

  start event E1 catch noninterrupt message msg;
  event E2 catch noninterrupt message msg;
  end event E3;

  E1 -> E2 -> E3;

}
