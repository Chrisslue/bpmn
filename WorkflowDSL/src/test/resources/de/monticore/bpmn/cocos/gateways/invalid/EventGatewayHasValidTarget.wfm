package de.monticore.bpmn.cocos.gateways.invalid;

import de.monticore.bpmn.cds.Domain.*;

process EventGatewayHasValidTarget {

  error err:Contract;
  escalation esc:Contract;

  task T1;

  event E1 catch cancel;
  event E2 catch error err;
  event E3 catch escalation esc;
  event E4 catch compensate;
  event E5 catch one {message msg, error err};
  event E6 catch all {message msg, error err};

  task T2;
  service task T3;
  send task T4{
    webservice = ##unspecified;
    message = msg;
  }
  manual task T5;
  rule task T6;
  script task T7;

  split xor G2;

  split receive first G1;

  T1 -> G1 -> {E1; E2; E3; E4; E5; E6; T2; T3; T4; T5; T6; T7; G2;};

}
