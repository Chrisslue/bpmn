package de.monticore.bpmn.cocos.flows.invalid;

process StartEventHasNoIncomingFlow {

  task T1;
  start event E1;
  task T2;
  end event E2;

  T1 -> E1 -> T2 -> E2;

  task T3;
  task T4;
  start event E3;
  end event E4;
  T3 -> E3 -> T4 -> E4;

}