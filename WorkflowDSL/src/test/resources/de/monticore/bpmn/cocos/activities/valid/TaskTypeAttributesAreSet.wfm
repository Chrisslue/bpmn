package de.monticore.bpmn.cocos.activities.valid;

process TaskTypeAttributesAreSet{

  service task T1{
    webservice = ##unspecified;
  }

  send task T2{
    webservice = ##unspecified;
    operation = call;
    message = confirm;
  }

  receive task T3{
    webservice = ##unspecified;
    operation = call;
    message = confirm;
  }

  user task T4{
    webservice = ##unspecified;
  }

  manual task T5{
    resources = Machine1,Item2,Item3;
  }

  rule task T6{
    webservice = ##unspecified;
  }

  script task T7{
    script ("python") = {"print(x)"};
  }
}