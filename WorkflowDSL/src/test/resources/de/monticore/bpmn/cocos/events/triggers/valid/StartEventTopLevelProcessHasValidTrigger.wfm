package de.monticore.bpmn.cocos.events.triggers.valid;

import de.monticore.bpmn.cds.Domain.*;

process StartEventTopLevelProcessHasValidTrigger {

  message msg:Contract;
  signal sig:Contract;

  start event E1;
  start event E2 message msg;
  start event E3 timer [on 19-11-2019 at 23:55];
  start event E4 when [true];
  start event E5 signal sig;
  start event E6 one { message msg, signal sig };
  start event E7 all { message msg, signal sig };

}