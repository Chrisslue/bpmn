package de.monticore.bpmn.cocos.events.triggers.valid;

import de.monticore.bpmn.cds.Domain.*;

process IntermediateThrowEventHasValidTrigger {

  escalation esc:Contract;
  message msg:Contract;
  signal sig:Contract;

  event E1;
  event E2 throw message msg;
  event E3 throw escalation esc;
  event E4 throw compensate;
  event E5 throw signal sig;
  event E6 throw all { message msg, signal sig };

}
