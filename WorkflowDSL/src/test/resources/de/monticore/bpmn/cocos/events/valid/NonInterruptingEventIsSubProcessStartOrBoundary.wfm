package de.monticore.bpmn.cocos.events.valid;

import de.monticore.bpmn.cds.Domain.*;

process NonInterruptingEventIsSubProcessStartOrBoundary {

  message msg:Contract;

  start event E1;
  subprocess S1 {
    start event E2 catch noninterrupt message msg;
    end event E3;

    E2 -> E3;
  }
  task T1 {
    boundary event E4 catch noninterrupt message msg;
  }
  end event E5;

  E1 -> S1 -> T1 -> E5;

}
