package de.monticore.bpmn.cocos.events.valid;

process AtLeastOneStartEventIfEndEventIsUsed {

  start event E1;
  task T1;
  end event E2;

  E1 -> T1 -> E2;

  subprocess S1 {
    start event E3;
    task T2;
    end event E4;

    E3 -> T2 -> E4;
  }

}