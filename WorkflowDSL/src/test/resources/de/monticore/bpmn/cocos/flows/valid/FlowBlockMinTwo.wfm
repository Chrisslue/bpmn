package de.monticore.bpmn.cocos.flows.valid;

process FlowBlockMinTwo {

  start event E1;
  end event E2;

  task T1;
  task T2;
  task T3;
  task T4;

  E1
    -> split xor
      -> {
           T1 -> T2;
           T3 -> T4;
         }
      -> merge xor
        -> E2;

}