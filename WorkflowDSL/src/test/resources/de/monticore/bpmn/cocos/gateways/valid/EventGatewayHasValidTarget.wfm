package de.monticore.bpmn.cocos.gateways.valid;

import de.monticore.bpmn.cds.Domain.*;

process EventGatewayHasValidTarget {

  message msg:Contract;
  signal sig:Contract;

  task T1;

  event E1 catch message msg;
  event E2 catch signal sig;
  event E3 catch timer [on 2019-11-25 at 20:38];
  event E4 catch when [false];
  event E5 catch one {message msg, signal sig, timer [on 2019-11-25 at 20:38], when [false]};
  event E6 catch all {message msg, signal sig, timer [on 2019-11-25 at 20:38], when [false]};

  split receive first G1;

  T1 -> G1 -> {E1; E2; E3; E4; E5; E6;};

}
