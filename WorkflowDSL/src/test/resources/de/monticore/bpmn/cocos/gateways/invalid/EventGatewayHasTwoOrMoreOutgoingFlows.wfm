package de.monticore.bpmn.cocos.gateways.invalid;

import de.monticore.bpmn.cds.Domain.*;

process EventGatewayHasTwoOrMoreOutgoingFlows {

  message msg:Contract;

  receive task T1{
    webservice = ##unspecified;
    message = msg;
  }
  receive task T2{
    webservice = ##unspecified;
    message = msg;
  }
  receive task T3{
    webservice = ##unspecified;
    message = msg;
  }

  split receive first G1;

  {T1; T2;} -> G1 -> T3;
}