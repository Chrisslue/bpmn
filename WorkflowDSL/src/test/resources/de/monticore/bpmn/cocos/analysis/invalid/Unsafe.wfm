package de.monticore.bpmn.cocos.analysis.invalid;

process Unsafe {

  task Task1;
  task Task2; // unsafe

  merge xor LoopEntry;
  split xor LoopExit;

  split and SplitGateway;

  start event Start;
  end event End1;
  end event End2;

  Start -> LoopEntry -> Task1 -> LoopExit -> End1;
  LoopExit -> SplitGateway -> LoopEntry;

  SplitGateway -> Task2 -> End2;

}
