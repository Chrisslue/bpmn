package de.monticore.bpmn.cocos.analysis.invalid;

process InfiniteLoop {

    task Task1;

    merge xor MergeGateway;
    split and SplitGateway;

    start event E1;
    end event E2;

    E1 -> MergeGateway -> Task1 -> SplitGateway -> E2;

    // loop back to merge gateway
    SplitGateway -> MergeGateway;

}
