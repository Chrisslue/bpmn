<packagedElement xmi:type="uml:DataType" name="Font" xmi:id="Font">
<ownedRule name="non_negative_size" xmi:id="Font-non_negative_size" constrainedElement="Font">
<specification xmi:type="uml:OpaqueExpression" xmi:id="Font-non_negative_size-_specification">
<body>size &gt;=  0</body>
<language>OCL</language>
</specification>
</ownedRule>
<ownedAttribute xmi:type="uml:Property" name="name" visibility="public" xmi:id="Font-name" type="String">
<lowerValue xmi:id="Font-namelowerValue" xmi:type="uml:LiteralInteger" value="0"/>
</ownedAttribute>
<ownedAttribute xmi:type="uml:Property" name="size" visibility="public" xmi:id="Font-size" type="Real">
<lowerValue xmi:id="Font-sizelowerValue" xmi:type="uml:LiteralInteger" value="0"/>
</ownedAttribute>
<ownedAttribute xmi:type="uml:Property" name="isBold" visibility="public" xmi:id="Font-isBold" type="Boolean">
<lowerValue xmi:id="Font-isBoldlowerValue" xmi:type="uml:LiteralInteger" value="0"/>
</ownedAttribute>
