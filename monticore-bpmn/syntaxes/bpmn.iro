#################################################################
## Iro
################################################################ 
##
## * Press Ctrl + '+'/'-' To Zoom in
## * Press Ctrl + S to save and recalculate... 
## * Documents are saved to web storage.
## * Only one save slot supported.
## * Matches cannot span lines.
## * Unicode chars must be defined in \u0000 to \uffff format.
## * All matches must be contained by a single group ( ... )
## * Look behinds not permitted, (?<= or (?<!
## * Look forwards are permitted (?= or (?!
## * Constants are defined as __my_const = (......)
## * The \= format allows unescaped regular expressions
## * Constants referenced by match \= $${__my_const}
## * Constants can reference other constants
## * You are free to delete all the default scopes.
## * Twitter : ainslec , Web: http://eeyo.io/iro
##
################################################################

name                   = wfm
file_extensions []     = wfm;

################################################################
## Constants
################################################################

__MC_NAME \= \b[a-zA-Z_$][a-zA-Z_0-9$]*\b
# capture as single group
__MC_QNAME \= ((?:$${__MC_NAME}(?:\.$${__MC_NAME})*))

################################################################
## Styles
################################################################

styles [] {

.whitespace : style {}

.comment : style {
   color             = grey
   italic            = true
   textmate_scope    = comment
}

.punctuation : style {
   color             = red_2
   textmate_scope    = punctuation
}

.text : style {
   color             = brown
   textmate_scope    = text
}

.illegal : style {
   color             = white
   background_color  = red
   textmate_scope    = invalid
}

.name : style {
   color             = cyan
   textmate_scope    = variable
   //entity.name.type
}

.keyword : style {
   color             = gold
   textmate_scope    = keyword.other
}

.import : style {
   color             = orange
   textmate_scope    = keyword.control.import
}

.flow_element : style {
   color             = violet_red
   textmate_scope    = entity.name.type
}

.task_type : style {
   color             = violet
   textmate_scope    = entity.other.attribute-name
}

.task_trigger : style {
   color             = light_blue
   textmate_scope    = keyword
}

.event_type : style {
   color             = orange
   textmate_scope    = constant.other
}

.event_behavior : style {
   color             = violet
   textmate_scope    = keyword.control
}

.event_trigger : style {
   color             = light_blue
   textmate_scope    = keyword
}

.gw_type : style {
   color             = violet
   textmate_scope    = keyword.control
}

.condition : style {
   color             = light_green
   textmate_scope    = meta.group
}

.data : style {
   color             = light_yellow
   textmate_scope    = variable.language
}

.type : style {
   color             = light_grey
   textmate_scope    = storage.type
}

.lane : style {
   color             = light_green
   textmate_scope    = meta.group
}

}

#################################################
## Parse contexts
#################################################

contexts [] {

##############################################
## Main Context - Entry point context
##############################################

main : context {

   : inline_push {
      regex          \= \b(import|package)\b
      styles []       = .import;
      : pop {
         regex       \= (;)
         styles []    = .punctuation;
      }
      : pattern {
         regex          \= ($${__MC_QNAME}(\.\*)?)
         styles []       = .type;
      }
   }

   : inline_push {
      regex          \= \b(task)\b
      styles []       = .flow_element;
      : pop {
         regex       \=  (?=\-\>|;|\})
         styles []    = .punctuation;
      }
      : pattern {
         regex          \= \b(service|send|receive|user|manual|decision|script)\b
         styles []       = .task_type;
      }
      : pattern {
         regex          \= \b(message)\b
         styles []       = .task_trigger;
      }
      : include "main";
   }
   
   : inline_push {
      regex          \= \b(split|merge)\b
      styles []       = .flow_element;
      : pop {
         regex       \=  (?=\-\>|;|\})
         styles []    = .punctuation;
      }
      : pattern {
         regex          \= \b(xor|ior|and|complex|receive)\b
         styles []       = .gw_type;
      }
      : include "main";
   }
   
   : inline_push {
      regex          \= \b(event)\b
      styles []       = .flow_element;
      : pop {
         regex       \= (?=\-\>|;|\})
         styles []    = .punctuation;
      }
      : pattern {
         regex          \= \b(start|end)\b
         styles []      = .event_type;
      }
      : pattern {
         regex          \= (receive|send)
         styles []       = .event_behavior;
      }
      : pattern {
         regex          \= \b(message|timer|error|escalate|cancel|compensate|when|signal|terminate|one|all)\b
         styles []       = .event_trigger;
      }
      : include "main";
   }
   
   : pattern {
      regex          \= \B(<<boundary>>)\B
      styles []      = .event_type;
   } 
   
   : inline_push {
      regex          \= \b(data|store|message|signal|escalation|error)\b
      styles []      = .data;
      : pop {
         regex       \= (;)
         styles []    = .punctuation;
      }
      : pattern {
         # generic type
         regex          \= (:)(\s*)$${__MC_QNAME}(<)(\s*)$${__MC_QNAME}(\s*)(>)
         styles []      = .punctuation, .whitespace, .type, .punctuation, .whitespace, .type, .whitespace, .punctuation;
      }
      : pattern {
         regex          \= (:)(\s*)$${__MC_QNAME}
         styles []      = .punctuation, .whitespace, .type;
      }
      : include "main";
   }
 
   : pattern {
      regex          \= \b(process|subprocess|transaction|adhoc)\b
      styles []       = .flow_element;
   }
   
   : pattern {
      regex          \= \b(lane)\b
      styles []       = .lane;
   }
   
   :pattern {
      regex          \= (\b(in|out|io|template|loop|while|until|max|multi|parallel|sequential|count|every|first|none|noninterrupt|async|as|compensate|implicit)\b|\B<<default>>\B)
      styles []       = .keyword;
   }
   
   : inline_push {
      regex          \= (\{)
      styles []       = .punctuation;
      : pop {  
         regex       \= (\})
         styles []    = .punctuation;
      }
      : include "main" ;
   }
   
   : inline_push {
      regex          \= (\[)
      styles []      = .condition;
      default_style  = .text
      : pop {  
         regex       \= (\])
         styles []    = .condition;
      }
      #: include "main" ;
   }
   
   : pattern {
      regex          \= (;|:|,|\?|\!)
      styles []       = .punctuation;
   }
   
   : pattern {
      regex          \= (\-\>)
      styles []       = .punctuation;
   }
   
   : inline_push {
      regex          \= (\")
      styles []       = .punctuation;
      default_style   = .text
      : pop {
         regex       \= (\")
         styles []    = .punctuation;
      }
   }
      
   : pattern {
      regex          \= $${__MC_QNAME}
      styles []       = .name;
   }
   
   : include "multi_line_comment" ;
   
   : pattern {
      regex          \= (//.*)
      styles []       = .comment;
   }
   
   : pattern {
      regex          \= ([^\s])
      styles []       = .illegal;
   }
   
}

#################################################
## End of Contexts
#################################################

###########################################
## Multi Line Comment Context
###########################################

multi_line_comment : context {
   description        = multiline
   : inline_push {
      regex          \= (/\*)
      styles []       = .comment;
      default_style   = .comment
      : pop {
         regex       \= (\*/)
         styles []    = .comment;
      }
   }
}
   
}
